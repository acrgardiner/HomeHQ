@using Microsoft.AspNetCore.Authorization
@using projectaardvarkx2.FileStorage
@using projectaardvarkx2.Services
@using projectaardvarkx2.Entities

@attribute [Authorize()]

@inject IJSRuntime JS

<MudDialog style="width: 100%; height: 100%">
    <TitleContent>
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Attachment</MudText>
            <MudButton Color="Color.Primary" OnClick="Close">Close</MudButton>
        </div>
    </TitleContent>
    <DialogContent>
        <MudContainer Fixed="true" style="height: 90%">
            @if (!string.IsNullOrEmpty(imageSource))
            {
                if (Attachment.ContentType.StartsWith( "image" ))
                {
                    <MudLink Href="@imageSource" Target="_blank">
                        <MudImage Src="@imageSource" Fluid="true" Class="rounded-lg" />
                    </MudLink>
                }
                else
                {
                    <iframe src="@imageSource" frameborder="0" style="display:block;" />
                }
            }
            else
            {
                <MudText>Loading images...</MudText>
            }
        </MudContainer>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }
    [Parameter][EditorRequired] public Attachment Attachment { get; set; }

    private readonly DialogOptions _maxWidthOptions = new() { MaxWidth = MaxWidth.Large };
    private string imageSource;

    protected override async Task OnInitializedAsync()
    {
        await MudDialog.SetOptionsAsync(_maxWidthOptions);


        imageSource = "/api/uploads/" + Attachment.Id.ToString();

    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));

}
