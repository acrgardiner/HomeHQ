@using Microsoft.AspNetCore.Components.Forms
@using HomeHQ.Services
@using HomeHQ.Entities
@using HomeHQ.Components.Entities.Common
@using Microsoft.AspNetCore.Authorization
@using HomeHQ.Helpers
@using HomeHQ.FileStorage
@using System.Linq.Expressions

@implements IAsyncDisposable

@attribute [Authorize()]

@inject ISnackbar Snackbar
@inject IEntityService<Attachment> AttachmentService
@inject IEntityService<AttachmentType> AttachmentTypeService
@inject IFileStorageService FileStorageService
@inject ILogger<Attachment_Sidebar> Logger
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<MudCard Elevation="2" Class="form-card attachments-card">
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-2" Color="Color.Warning" />
                <MudText Typo="Typo.h6">Attachments</MudText>
                @if (_connectionLost)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">
                        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Small" Class="mr-1" />
                        Offline - Data Safe
                    </MudChip>
                }
            </div>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (_attachments.Any())
            {
                <div class="d-flex align-center">
                    <MudText Typo="Typo.caption" Class="mr-3 mud-text-secondary">
                        @(_currentAttachmentIndex + 1) of @_attachments.Count
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Disabled="@(_currentAttachmentIndex <= 0)"
                                   OnClick="PreviousAttachment" />
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Disabled="@(_currentAttachmentIndex >= _attachments.Count - 1)"
                                   OnClick="NextAttachment" />
                </div>
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudDivider />
    <MudCardContent>
        <!-- Upload Buttons -->
        <MudStack Spacing="2" Class="mb-4">
            @if(!ReadOnly){
                @if (IsMobile)
                {
                    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                   FilesChanged="AddAttachmentClientSide"
                                   accept="image/*"
                                   Capture="environment">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Camera"
                                       FullWidth="true"
                                       Class="upload-btn"
                                       Disabled="_uploading">
                                @if (_uploading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Loading...</span>
                                }
                                else
                                {
                                    <span>Take Photo</span>
                                }
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                   FilesChanged="AddAttachmentClientSide"
                                   accept="image/*">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Image"
                                       FullWidth="true"
                                       Class="upload-btn"
                                       Disabled="_uploading">
                                From Gallery
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                }
                else
                {
                    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                   FilesChanged="AddAttachmentClientSide"
                                   accept="image/*,application/pdf">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       FullWidth="true"
                                       Class="upload-btn"
                                       Disabled="_uploading">
                                @if (_uploading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Loading...</span>
                                }
                                else
                                {
                                    <span>Upload Files</span>
                                }
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                }
            }
        </MudStack>

        <!-- Attachments List -->
        @if (_attachments.Any())
        {
            <div class="attachment-carousel">
                @{
                    var currentAttachment = _attachments[_currentAttachmentIndex];
                }
                 <!-- Main Attachment Display -->
                 <div class="attachment-display mb-4" @onclick="@(async () => await ImageDialogOpen())" >
                    @if (IsImageAttachment(currentAttachment.Attachment))
                    {
                        <div class="attachment-preview image-preview">
                            <MudImage Src="@currentAttachment.GetImagePreviewUrl()"
                                      Alt="@currentAttachment.Attachment.OriginFileName"
                                      Class="attachment-image"
                                      ObjectFit="ObjectFit.Cover" />
                                                         <div class="attachment-overlay">
                                <MudIconButton Icon="@Icons.Material.Filled.ZoomIn"
                                    Size="Size.Large"
                                    Color="Color.Primary"
                                    Variant="Variant.Filled"
                                    Class="zoom-button" OnClick="@(async () => await ImageDialogOpen())" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="attachment-preview file-preview">
                            <div class="file-icon-container">
                                <MudIcon Icon="@GetAttachmentIcon(currentAttachment.Attachment)"
                                         Size="Size.Large"
                                         Color="Color.Primary" />
                            </div>
                            <div class="attachment-overlay">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Large"
                                               Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               Class="view-button" @onclick="@(async () => await ImageDialogOpen())" />
                            </div>
                        </div>
                    }
                </div>

                <!-- Attachment Info -->
                <div class="attachment-info mb-3">
                    <div class="d-flex align-center justify-space-between">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @Formatter.FormatFileSize(currentAttachment.Attachment.FileSize) • @currentAttachment.Attachment.Extension?.ToUpper()
                        </MudText>
                    </div>
                    <div class="d-flex align-center justify-space-between">
                        <MudSelect T="AttachmentType"
                                   @bind-Value="_attachments[_currentAttachmentIndex].Attachment.AttachmentType"
                                   Label="Type"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="_uploading" ReadOnly="@ReadOnly">
                            @foreach (var type in AttachmentTypes)
                            {
                                <MudSelectItem T="AttachmentType" Value="@type">@type.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if(!ReadOnly){
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Variant="Variant.Text" OnClick="() => Remove(currentAttachment)" />
                        }
                    </div>
                </div>
                <!-- Thumbnail Navigation (if more than one attachment) -->
                @if (_attachments.Count > 1)
                {
                    <div class="attachment-thumbnails">
                        <MudStack Row="true" Spacing="1" Justify="Justify.Center">
                            @for (int i = 0; i < _attachments.Count; i++)
                            {
                                var index = i; // Capture for closure
                                var attachment = _attachments[i];
                                var isActive = i == _currentAttachmentIndex;

                                <div class="thumbnail-container @(isActive ? "active" : "")"
                                     @onclick="@(() => SetCurrentAttachment(index))">
                                    @if (IsImageAttachment(attachment.Attachment))
                                    {
                                        <MudImage Src="@attachment.GetImagePreviewUrl()"
                                                  Alt="@attachment.Attachment.OriginFileName"
                                                  Class="thumbnail-image"
                                                  ObjectFit="ObjectFit.Cover" />
                                    }
                                    else
                                    {
                                        <div class="thumbnail-file">
                                            <MudIcon Icon="@GetAttachmentIcon(attachment.Attachment)"
                                                     Size="Size.Small"
                                                     Color="Color.Primary" />
                                        </div>
                                    }
                                </div>
                            }
                        </MudStack>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-column align-center justify-center py-6 text-center">
                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-1">No attachments yet</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Upload receipts, photos, or documents</MudText>
            </div>
        }
    </MudCardContent>
</MudCard>

<MudDialog style="width: 100%; height: 100%" @bind-Visible="_dialogVisible" Options="_maxWidthOptions">
    <TitleContent>
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Attachment</MudText>
            <div class="d-flex align-center gap-2">
                @if (IsImageAttachment(_attachments[_currentAttachmentIndex].Attachment) && !ReadOnly/* && _attachments[_currentAttachmentIndex].FileBytes != null*/)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.RotateLeft" OnClick="@(() => Rotate(-90))" title="Rotate Left" />
                    <MudIconButton Icon="@Icons.Material.Filled.RotateRight" OnClick="@(() => Rotate(90))" title="Rotate Right" />
                    <MudIconButton Icon="@(_cropModeEnabled ? Icons.Material.Filled.Crop : Icons.Material.Filled.CropFree)" 
                                   Color="@(_cropModeEnabled ? Color.Success : Color.Default)"
                                   OnClick="@ToggleCropMode"
                                   title="@(_cropModeEnabled ? "Disable Crop" : "Enable Crop")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="@(async () => await AcceptCrop())" title="Save" />
                }
                @if (ReadOnly)
                {
                    <MudIconButton Icon="@(_imageFitMode == ImageFitMode.Width ? Icons.Material.Filled.PhotoSizeSelectLarge : Icons.Material.Filled.PhotoSizeSelectSmall)"
                                   Color="Color.Primary"
                                   OnClick="@ToggleImageFitMode"
                                   title="Switch Fill Mode" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Primary" OnClick="@(async () => await ImageDialogClose())" title="Close" />
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudContainer Fixed="true" style="height: 90%;">
            @if (IsImageAttachment(_attachments[_currentAttachmentIndex].Attachment))
            {
                    @if (@ReadOnly)
                    {
                        @code {
                            private enum ImageFitMode
                            {
                                Width,
                                Height
                            }

                            private ImageFitMode _imageFitMode = ImageFitMode.Height;

                            private void ToggleImageFitMode()
                            {
                                _imageFitMode = _imageFitMode == ImageFitMode.Width ? ImageFitMode.Height : ImageFitMode.Width;
                            }

                            private string GetImageStyle()
                            {
                                return _imageFitMode switch
                                {
                                    ImageFitMode.Width => "width: 100%; object-fit: contain; display: flex; justify-content: center; align-items: center;",
                                    ImageFitMode.Height => "max-width: 100%; height: 100%; object-fit: contain; display: flex; justify-content: center; align-items: center;",
                                    _ => "max-width: 100%; max-height: 100%; object-fit: contain;"
                                };
                            }
                        }

                        <a href="@_attachments[_currentAttachmentIndex].GetImageUrl()" target="_blank" style="@GetImageStyle()">
                            <MudImage Src="@_attachments[_currentAttachmentIndex].GetImageUrl()"
                                Alt="@_attachments[_currentAttachmentIndex].Attachment.OriginFileName"
                                Style="@GetImageStyle()" />
                        </a>
                    }
                    else
                    {
                        <div style="position: relative; width: 100%; height: 100%;">
                            <div id="image-editor-container" style="width: 100%; height: 100%; justify-content: center; align-items: center; display: flex;">
                            </div>
                            @if (_cropModeEnabled)
                            {
                                <div style="position: absolute; top: 10px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.7); color: white; padding: 8px 16px; border-radius: 4px; pointer-events: none; z-index: 1000;">
                                    <MudText Typo="Typo.body2">Click and drag to create crop area</MudText>
                                </div>
                            }
                        </div>
                    }
            }
            else
            {
                <iframe src="@_attachments[_currentAttachmentIndex].GetImageUrl()"
                        frameborder="0"
                        style="width: 100%; height: 100%; display: block;" />
            }
        </MudContainer>
    </DialogContent>
</MudDialog>

@code {

    [Parameter] public Guid? ParentId { get; set; }
    [Parameter] public bool IsMobile { get; set; } = false;
    [Parameter] public string? ParentType { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = false;


    private List<Attachment_wfile> _attachments = new();
    private const long MaxPreviewSize = 30 * 1024 * 1024;
    private bool _uploading = false;
    private bool _connectionLost = false;

    private List<AttachmentType> AttachmentTypes = new();
    private Guid DefaultAttachmentTypeId;
    private AttachmentType DefaultAttachmentType = new();

    private int _currentAttachmentIndex = 0;

    private bool _dialogVisible = false;
    private readonly DialogOptions _maxWidthOptions = new() { MaxWidth = MaxWidth.Large };
    private const string EditorContainerId = "image-editor-container";
    private bool _editorInitialized = false;
    private bool _cropModeEnabled = false;

    // Session ID for IndexedDB storage - persists across reconnections via browser
    private string _sessionId = string.Empty;
    private bool _storageInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AttachmentTypes = (await AttachmentTypeService.GetAsync()).ToList();

            if (AttachmentTypes.Count == 0)
            {
                Snackbar.Add("No attachment types found. Please create at least one attachment type.", Severity.Error);
                return;
            }

            DefaultAttachmentType = AttachmentTypes.Where(a => a.Default).First();
            DefaultAttachmentTypeId = DefaultAttachmentType.Id;

            if (ParentId != Guid.Empty)
            {
                _attachments = (await AttachmentService.GetAsync(
                    filter: x => x.ParentId == ParentId,
                    orderby: x => x.CreatedOn,
                    descending: true,
                    take: 10
                )).Select(a => new Attachment_wfile { Attachment = a }).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load attachments");
            Snackbar.Add("Failed to load", Severity.Error);
        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeClientStorage();
        }
    }

    private async Task InitializeClientStorage()
    {
        try
        {
            // Generate session ID based on ParentId + ParentType for recovery
            _sessionId = $"{ParentType}_{ParentId?.ToString() ?? "new"}";
            
            // Initialize IndexedDB
            await JSRuntime.InvokeVoidAsync("AttachmentStorageInterop.init");
            _storageInitialized = true;

            // Check for pending attachments from previous session (recovery after disconnect)
            await RecoverPendingAttachments();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to initialize client storage - falling back to server-side");
            _storageInitialized = false;
        }
    }

    private async Task RecoverPendingAttachments()
    {
        try
        {
            var hasPending = await JSRuntime.InvokeAsync<bool>("AttachmentStorageInterop.hasPendingAttachments", _sessionId);
            
            if (hasPending)
            {
                var pendingItems = await JSRuntime.InvokeAsync<List<ClientStorageItem>>("AttachmentStorageInterop.getSessionAttachments", _sessionId);
                
                if (pendingItems?.Any() == true)
                {
                    foreach (var item in pendingItems)
                    {
                        // Check if we already have this attachment in our list
                        if (_attachments.Any(a => a.ClientStorageId == item.Id))
                            continue;

                        var attachment = new Attachment
                        {
                            OriginFileName = item.Metadata?.FileName ?? "recovered",
                            Extension = item.Metadata?.Extension ?? "",
                            ContentType = item.Metadata?.ContentType ?? "image/jpeg",
                            FileSize = item.Metadata?.Size ?? 0,
                            AttachmentTypeId = DefaultAttachmentTypeId,
                            AttachmentType = DefaultAttachmentType
                        };

                        var recovered = new Attachment_wfile
                        {
                            Attachment = attachment,
                            IsNew = true,
                            ClientStorageId = item.Id,
                            DataUrl = item.DataUrl
                        };

                        _attachments.Add(recovered);
                    }

                    if (pendingItems.Count > 0)
                    {
                        _connectionLost = false; // We recovered successfully
                        Snackbar.Add($"Recovered {pendingItems.Count} pending attachment(s)", Severity.Success);
                        StateHasChanged();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to recover pending attachments");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_editorInitialized)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("ImageEditorInterop.destroy", EditorContainerId);
            }
            catch
            {
                // Circuit may already be disposed
            }
        }
    }

    private void NextAttachment()
    {
        if (_currentAttachmentIndex < _attachments.Count - 1)
        {
            _currentAttachmentIndex++;
        }
    }

    private void PreviousAttachment()
    {
        if (_currentAttachmentIndex > 0)
        {
            _currentAttachmentIndex--;
        }
    }

    private void SetCurrentAttachment(int index)
    {
        if (index >= 0 && index < _attachments.Count)
        {
            _currentAttachmentIndex = index;
        }
    }

    /// <summary>
    /// New method that stores files client-side in IndexedDB first
    /// This prevents data loss on SignalR disconnection
    /// </summary>
    private async Task AddAttachmentClientSide(IReadOnlyList<IBrowserFile> files)
    {
        _uploading = true;
        StateHasChanged();

        try
        {
            foreach (var file in files)
            {
                try
                {
                    var clientId = Guid.NewGuid().ToString();
                    
                    if (_storageInitialized)
                    {
                        // Read file and store in IndexedDB client-side
                        using var stream = file.OpenReadStream(MaxPreviewSize);
                        using var ms = new MemoryStream();
                        await stream.CopyToAsync(ms);
                        var bytes = ms.ToArray();

                        // Store in IndexedDB via JS interop
                        var metadata = new
                        {
                            fileName = file.Name,
                            contentType = file.ContentType,
                            size = file.Size,
                            extension = Path.GetExtension(file.Name)
                        };

                        await JSRuntime.InvokeVoidAsync("attachmentStorage.store", 
                            clientId, 
                            _sessionId, 
                            metadata, 
                            bytes);

                        // Get data URL for display
                        var dataUrl = await JSRuntime.InvokeAsync<string>("AttachmentStorageInterop.getDataUrl", clientId);

                        var attachment = new Attachment
                        {
                            OriginFileName = file.Name,
                            Extension = Path.GetExtension(file.Name),
                            ContentType = file.ContentType,
                            FileSize = file.Size,
                            AttachmentTypeId = DefaultAttachmentTypeId,
                            AttachmentType = DefaultAttachmentType
                        };

                        var attachmentWithFile = new Attachment_wfile
                        {
                            Attachment = attachment,
                            IsNew = true,
                            ClientStorageId = clientId,
                            DataUrl = dataUrl
                        };

                        _attachments.Add(attachmentWithFile);
                        Snackbar.Add($"Photo loaded (stored locally)", Severity.Success);
                    }
                    else
                    {
                        // Fallback: store in server memory (original behavior)
                        await AddAttachmentServerSide(file);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to add attachment {FileName}", file.Name);
                    Snackbar.Add($"Failed to load {file.Name}: {ex.Message}", Severity.Error);
                }
            }
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Fallback method for when IndexedDB is not available
    /// </summary>
    private async Task AddAttachmentServerSide(IBrowserFile file)
    {
        var fileExtension = Path.GetExtension(file.Name);

        var attachment = new Attachment
        {
            OriginFileName = file.Name,
            Extension = fileExtension,
            ContentType = file.ContentType,
            FileSize = file.Size,
            AttachmentTypeId = DefaultAttachmentTypeId,
            AttachmentType = DefaultAttachmentType
        };

        using var stream = file.OpenReadStream(MaxPreviewSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        var attachmentWithFile = new Attachment_wfile(attachment, bytes) { IsNew = true };
        _attachments.Add(attachmentWithFile);
        
        Snackbar.Add($"Photo loaded", Severity.Success);
    }

    public async Task<bool> SaveAttachments(Guid Id)
    {
        try
        {
            foreach (var item in _attachments)
            {
                byte[]? bytes = null;

                // Get bytes from appropriate source
                if (item.ClientStorageId != null && _storageInitialized)
                {
                    // Get bytes from IndexedDB
                    var byteArray = await JSRuntime.InvokeAsync<int[]?>("AttachmentStorageInterop.getImageBytes", item.ClientStorageId);
                    if (byteArray != null)
                    {
                        bytes = byteArray.Select(i => (byte)i).ToArray();
                    }
                }
                else if (item.FileBytes != null)
                {
                    // Fallback to server-side bytes
                    bytes = item.FileBytes;
                }

                if (item.IsNew && bytes != null)
                {
                    item.Attachment.ParentId = Id;
                    item.Attachment.ParentType = ParentType!;
                    await FileStorageService.UploadAsync<Asset>(bytes, item.Attachment);

                    var uploadedAttachment = await AttachmentService.AddAsync(item.Attachment);

                    // Clear from IndexedDB after successful save
                    if (item.ClientStorageId != null && _storageInitialized)
                    {
                        await JSRuntime.InvokeVoidAsync("AttachmentStorageInterop.remove", item.ClientStorageId);
                    }
                }

                if (!item.IsNew && bytes != null)
                {
                    // If edited, flag old attachment for deletion and re-upload
                    var newAttachment = new Attachment(item.Attachment);
                    await AttachmentService.DeleteAsync(item.Attachment.Id);

                    await FileStorageService.UploadAsync<Asset>(bytes, newAttachment);

                    var uploadedAttachment = await AttachmentService.AddAsync(newAttachment);

                    // Clear from IndexedDB after successful save
                    if (item.ClientStorageId != null && _storageInitialized)
                    {
                        await JSRuntime.InvokeVoidAsync("AttachmentStorageInterop.remove", item.ClientStorageId);
                    }
                }
            }

            // Clear entire session from IndexedDB
            if (_storageInitialized)
            {
                await JSRuntime.InvokeVoidAsync("AttachmentStorageInterop.clearSession", _sessionId);
            }

            _attachments.Clear();
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save attachments");
            Snackbar.Add($"Failed to save attachments: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task Remove(Attachment_wfile item)
    {
        if (item.ClientStorageId != null && _storageInitialized)
        {
            // Remove from IndexedDB
            await JSRuntime.InvokeVoidAsync("AttachmentStorageInterop.remove", item.ClientStorageId);
        }
        
        if (item.FileBytes == null && item.ClientStorageId == null)
        {
            // Attachment is on server, remove from database
            await AttachmentService.DeleteAsync(item.Attachment.Id);
        }
        
        _attachments.Remove(item);
        
        // Adjust index if needed
        if (_currentAttachmentIndex >= _attachments.Count && _attachments.Count > 0)
        {
            _currentAttachmentIndex = _attachments.Count - 1;
        }
    }

    /// <summary>
    /// DTO for receiving data from IndexedDB
    /// </summary>
    class ClientStorageItem
    {
        public string Id { get; set; } = "";
        public ClientStorageMetadata? Metadata { get; set; }
        public string? DataUrl { get; set; }
    }

    class ClientStorageMetadata
    {
        public string? FileName { get; set; }
        public string? ContentType { get; set; }
        public long Size { get; set; }
        public string? Extension { get; set; }
    }

    class Attachment_wfile
    {
        public Attachment Attachment;
        public byte[]? FileBytes;
        public bool IsNew = false;
        
        // Client-side storage support
        public string? ClientStorageId;
        public string? DataUrl;

        public Attachment_wfile()
        {
            Attachment = new Attachment();
            FileBytes = null;
        }

        public Attachment_wfile(Attachment attachment, byte[]? fileBytes = null)
        {
            Attachment = attachment;
            FileBytes = fileBytes;
        }

        public string GetImageUrl()
        {
            // Priority: DataUrl (from IndexedDB) -> FileBytes (server memory) -> Server URL
            if (!string.IsNullOrEmpty(DataUrl))
            {
                return DataUrl;
            }
            
            if (FileBytes != null)
            {
                var base64 = Convert.ToBase64String(FileBytes);
                return $"data:{Attachment.ContentType};base64,{base64}";
            }
            
            // Attachment is on server, use URL
            return $"/api/uploads/{Attachment!.Id}";
        }

        public string GetImagePreviewUrl()
        {
            // For new attachments, use the same URL as full image
            if (!string.IsNullOrEmpty(DataUrl))
            {
                return DataUrl;
            }
            
            if (FileBytes != null)
            {
                var base64 = Convert.ToBase64String(FileBytes);
                return $"data:{Attachment!.ContentType};base64,{base64}";
            }
            
            // Attachment is on server, use preview URL
            return $"/api/uploads/{Attachment!.Id}/preview";
        }
    }

    private bool IsImageAttachment(Attachment attachment)
    {
        return !string.IsNullOrEmpty(attachment.ContentType) && attachment.ContentType.StartsWith("image/");
    }

    private async Task NavigateToAttachment(Attachment attachment)
    {
        await JSRuntime.InvokeVoidAsync("open", $"/api/uploads/{attachment.Id}", "_blank");
    }

    private string GetAttachmentIcon(Attachment attachment)
    {
        if (string.IsNullOrEmpty(attachment.ContentType))
            return Icons.Material.Filled.AttachFile;

        return attachment.ContentType.StartsWith("image/") switch
        {
            true => Icons.Material.Filled.Image,
            false when attachment.ContentType.Contains("pdf") => Icons.Material.Filled.PictureAsPdf,
            false when attachment.ContentType.Contains("document") => Icons.Material.Filled.Description,
            false when attachment.ContentType.Contains("spreadsheet") => Icons.Material.Filled.GridOn,
            _ => Icons.Material.Filled.AttachFile
        };
    }

    private async Task ImageDialogClose()
    {
        if (_editorInitialized)
        {
            await JSRuntime.InvokeVoidAsync("ImageEditorInterop.destroy", EditorContainerId);
            _editorInitialized = false;
        }
        _cropModeEnabled = false;
        _dialogVisible = false;
    }

    private async Task ImageDialogOpen()
    {
        _dialogVisible = true;
        _cropModeEnabled = false;
        
        if (!ReadOnly && IsImageAttachment(_attachments[_currentAttachmentIndex].Attachment))
        {
            // Wait for dialog to render
            await Task.Delay(100);
            
            var imageSrc = _attachments[_currentAttachmentIndex].GetImageUrl();
            _editorInitialized = await JSRuntime.InvokeAsync<bool>("ImageEditorInterop.initialize", EditorContainerId, imageSrc);
        }
    }

    private async Task ToggleCropMode()
    {
        if (!_editorInitialized) return;

        _cropModeEnabled = !_cropModeEnabled;

        if (_cropModeEnabled)
        {
            await JSRuntime.InvokeVoidAsync("ImageEditorInterop.enableCrop", EditorContainerId);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("ImageEditorInterop.disableCrop", EditorContainerId);
        }
    }

    private async Task Rotate(decimal degree)
    {
        if (_editorInitialized)
        {
            await JSRuntime.InvokeVoidAsync("ImageEditorInterop.rotate", EditorContainerId, (int)degree);
        }
    }

    public async Task AcceptCrop()
    {
        if (_editorInitialized)
        {
            try
            {
                var imageDataArray = await JSRuntime.InvokeAsync<int[]>("ImageEditorInterop.getCroppedImageData", EditorContainerId);
                
                if (imageDataArray != null)
                {
                    var attachment = _attachments[_currentAttachmentIndex];
                    
                    if (attachment.ClientStorageId != null && _storageInitialized)
                    {
                        // Update in IndexedDB and get new data URL
                        var newDataUrl = await JSRuntime.InvokeAsync<string>("AttachmentStorageInterop.updateImageData", 
                            attachment.ClientStorageId, 
                            imageDataArray);
                        
                        attachment.DataUrl = newDataUrl;
                        
                        // Update file size
                        attachment.Attachment.FileSize = imageDataArray.Length;
                    }
                    else
                    {
                        // Fallback: store in server memory
                        var croppedCanvasData = imageDataArray.Select(i => (byte)i).ToArray();
                        attachment.FileBytes = croppedCanvasData;
                    }
                    
                    Snackbar.Add("Image saved successfully", Severity.Success);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to save cropped image");
                Snackbar.Add("Failed to save image", Severity.Error);
            }
        }

        await ImageDialogClose();
    }
}
