@typeparam TEntityType where TEntityType : AuditableEntity

@using System.Text
@using Microsoft.JSInterop
@using System.Reflection
@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using projectaardvarkx2.Services
@using projectaardvarkx2.Entities
@using projectaardvarkx2.Contracts

@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="@MaxWidth" Class="mt-6">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">@Plural</MudText>
    <MudPaper Class="p-4">
        <MudDataGrid T="TEntityType" Items="@_entities" Loading="@_loading" QuickFilter="@_quickFilter"
                Hideable="true" Hover="true" Dense="true"
                Striped="false" Bordered="false" ReadOnly="true" Class="elevation-1">
            <ToolBarContent>
                <MudTextField @bind-Value="SearchString" Placeholder="Search..." Adornment="Adornment.Start" Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mx-2" />
                <MudIconButton  Color="Color.Primary" Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium" OnClick="ReloadData"/>
                @if (CreateDialog != null)
                {
                    <MudIconButton  Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Filled.Add"
                    Size="Size.Medium" OnClick="OpenCreateDialog"  />
                }
                @if (ToolbarActions != null)
                {
                    @ToolbarActions
                }
                @if (EnableExport)
                {
                        <MudIconButton  Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Filled.Download"
                    Size="Size.Medium" OnClick="ExportToCsv" />
                }
            </ToolBarContent>
            <Columns>
                @if (Columns != null)
                {
                    @foreach (var column in Columns)
                    {
                        <TemplateColumn T="TEntityType" Title="@column.Title">
                            <CellTemplate>
                                @*@column.Selector(context.Item)*@
                                    @{
                                        var value = column.Selector(context.Item);
                                        if (value is RenderFragment fragment)
                                        {
                                            @fragment
                                        }
                                        else
                                        {
                                            @value
                                        }
                                    }
                            </CellTemplate>
                        </TemplateColumn>
                    }
                }
                <TemplateColumn T="TEntityType" Title="Actions">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0" Class="pa-2">
                            @if (ItemActions != null)
                            {
                                @foreach (var action in ItemActions)
                                {
                                    <div>
                                        <MudIconButton Icon="@action.Icon" Color="Color.Primary" Size="Size.Small" Class="mx-1"
                                        OnClick="() => action.Action(context.Item)" />
                                    </div>
                                }
                            }
                            <div>
                                @if (EditDialog != null) {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Class="mx-1"
                                    OnClick="@(() => OpenEditDialog(context.Item))" />
                                }
                            </div>
                            @if (EnableItemDelete)
                            {
                                <div>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                    Size="Size.Small" Class="mx-1"
                                    OnClick="@(() => OpenDeleteDialog(context.Item))" />
                                </div>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="TEntityType" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public ILogger Logger { get; set; }

    [Parameter] public MaxWidth MaxWidth { get; set; } = MaxWidth.Large;

    [Parameter] public string Plural { get; set; } = "Entities";
    [Parameter] public string Singular { get; set; } = "Entity";

    [Parameter] public IEntityService<TEntityType> EntityService { get; set; } = default!;

    [Parameter] public List<(Func<TEntityType, object?> Selector, string Title)>? Columns { get; set; } = null;
    [Parameter] public RenderFragment? ToolbarActions { get; set; }

    [Parameter] public Func<TEntityType, bool>? QuickFilter { get; set; }
    [Parameter] public List<Expression<Func<TEntityType, object>>>? Includes { get; set; }
    
    [Parameter] public Func<Task<IDialogReference>>? CreateDialog { get; set; }
    [Parameter] public Func<DialogParameters, Task<IDialogReference>>? EditDialog { get; set; }

    [Parameter] public List<EntityAction<TEntityType>>? ItemActions { get; set; }
    [Parameter] public bool EnableItemDelete { get; set; } = true;
    [Parameter] public bool EnableExport { get; set; } = true;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<TEntityType> _entities = new();
    private bool _loading = true;
    private string _searchString = string.Empty;
    private string SearchString
    {
        get => _searchString;
        set
        {
            if (_searchString != value)
            {
                _searchString = value;
                StateHasChanged();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task ReloadData() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            if (Includes == null)
                _entities = (await EntityService.GetAllAsync()).ToList();
            else
                _entities = (await EntityService.GetAllAsync(Includes)).ToList();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    //private Func<TEntityType, bool> _quickFilter => QuickFilter ?? (x => string.IsNullOrWhiteSpace(_searchString) ? true : x?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true);
    private Func<TEntityType, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;
        // Check if any property contains the search string
        return Columns.Any(c =>
            c.Selector(x)?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true);
    };

    private async Task ExportToCsv()
    {
        var csv = new StringBuilder("\uFEFF");
        csv.AppendLine(string.Join(",", Columns.Select(c => c.Title)));
        // Rows
        foreach (var item in _entities)
        {
            csv.AppendLine(string.Join(",", Columns.Select(c => EscapeCsv(c.Selector(item)?.ToString() ?? ""))));
        }

        //var utf8WithBom = new UTF8Encoding(encoderShouldEmitUTF8Identifier: true);
        //var bytes = utf8WithBom.GetBytes(csv.ToString());
        //var base64 = Convert.ToBase64String(bytes);

        var now = DateTime.UtcNow.ToString("yyyyMMddHHmm");

        await JS.InvokeVoidAsync("downloadFileFromBase64", $"{typeof(TEntityType).Name.ToLowerInvariant()}_list_{now}.csv", csv.ToString());
    }

    private string EscapeCsv(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return "";
        if (value.Contains(",") || value.Contains("\"") || value.Contains("\n"))
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }

    @*  Create Dialog *@
    private async Task OpenCreateDialog()
    {
        try
        {
            // var dialog = await CreateDialog();
            // var result = await dialog.Result;

            // if (!result.Canceled)
            // {
            //     await LoadData();
            //     Snackbar.Add($"{Singular} created successfully", Severity.Success);
            // }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open create dialog for {EntityType}", typeof(TEntityType).Name);
            Snackbar.Add($"Failed to open created dialog for {Singular}", Severity.Error);
        }
    }

    @*  Edit Dialog *@
    private async Task OpenEditDialog(TEntityType entity)
    {
        try
        {
            var parameters = new DialogParameters
                {
                    ["Entity"] = entity,
                    ["Title"] = $"Edit {Singular}: {entity.Id}"
                };

            var dialog = await EditDialog(parameters);
            var result = await dialog.Result;

            if (!result.Canceled)
            {
                await LoadData();
                Snackbar.Add($"{Singular} updated successfully", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open edit dialog for {EntityType}", typeof(TEntityType).Name);
            Snackbar.Add($"Failed to open edit dialog for {Singular}", Severity.Error);
        }
    }

    @* Delete Dialog  *@
    public async Task OpenDeleteDialog(TEntityType entity)
    {
        var parameters = new DialogParameters
            {
                ["Id"] = entity.Id,
                ["Message"] = $"Are you sure you want to delete this {Singular}? This action cannot be undone."
            };

        var dialog = await DialogService.ShowAsync<DeleteConfirmation>("Confirm Deletion", parameters);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                await EntityService.DeleteAsync(entity.Id);
                await LoadData();
                Snackbar.Add($"{Singular} deleted successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to delete user");
                Snackbar.Add($"Failed to delete {Singular}", Severity.Error);
            }
        }
    }


}