@using projectaardvarkx2.Identity
@using projectaardvarkx2.Entities
@using projectaardvarkx2.Services
@inject IEntityService<Category> CategoryService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Category</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="@model">
            <MudTextField T="string" @bind-Value="model.Name" Label="Name" Required="true" RequiredError="Name is required!" />
            <MudTextField T="string" @bind-Value="model.Icon" Label="Icon" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ILogger<EditCategory> _logger { get; set; }
    [CascadingParameter] IMudDialogInstance Dialog { get; set; }

    [Parameter] public Category Entity { get; set; }
    [Parameter] public string Title { get; set; }

    private MudForm form;
    private Category model = new();

    protected override void OnInitialized()
    {
        model = Entity;
    }

    private void Cancel() => Dialog.Cancel();

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                await CategoryService.UpdateAsync(model);
                Snackbar.Add("updated successfully", Severity.Success);
                Dialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error updating");
                Snackbar.Add("Error updating", Severity.Error);
            }
        }
    }
}