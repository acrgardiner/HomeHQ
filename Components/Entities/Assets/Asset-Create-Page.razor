@page "/assets/create"
@using projectaardvarkx2.Entities
@using projectaardvarkx2.Services
@using projectaardvarkx2.Helpers
@using projectaardvarkx2.FileStorage
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<Asset> AssetService
@inject IEntityService<Category> CategoryService
@inject IEntityService<WarrantyType> WarrantyTypeService
@inject IEntityService<AttachmentType> AttachmentTypeService
@inject IEntityService<Attachment> AttachmentService
@inject IEntityService<AttributeValue> AttributeService
@inject IFileStorageService FileStorageService

@inject ICurrentUserService CurrentUser

@inject ISnackbar Snackbar
@inject ILogger<Asset_Create_Page> Logger
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <EditForm Model="@asset" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <!-- Header -->
        <div class="d-flex align-center mb-6">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                          Size="Size.Medium" 
                          OnClick="GoBack" 
                          Class="mr-3" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.h4" Color="Color.Primary">New Asset</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Add a new asset to your inventory with all relevant details
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           StartIcon="@Icons.Material.Filled.Save"
                           Class="asset-action-btn">
                    Save
                </MudButton>
            </MudStack>
        </div>

        <MudGrid Spacing="4">
            <MudItem xs="12" lg="8">
                <!-- Basic Information Card -->
                <MudCard Elevation="2" Class="form-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Color="Color.Primary" />
                                <MudText Typo="Typo.h6">Basic Information</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="asset.Name" 
                                    Label="Name" 
                                    Required="true"
                                    Variant="Variant.Outlined"
                                    HelperText="Enter a descriptive name for your asset"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.Label" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="asset.CategoryId" 
                                    T="Guid?" 
                                    Label="Category" 
                                    Required="true"
                                    Variant="Variant.Outlined"
                                    AnchorOrigin="Origin.BottomCenter"
                                    HelperText="Select the category that best describes this asset">
                                    <MudSelectItem Value="@(null as Guid?)">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-2" Size="Size.Small" />
                                            -- Select Category --
                                        </div>
                                    </MudSelectItem>
                                    @foreach (var cat in categories)
                                    {
                                        <MudSelectItem Value="@(cat.Id as Guid?)">
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@cat.Icon" Class="mr-2" Size="Size.Small" />
                                                @cat.Title
                                            </div>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudDatePicker @bind-Date="asset.PurchaseDate" 
                                             Label="Purchase Date" 
                                             Required="true"
                                             Variant="Variant.Outlined"
                                             HelperText="When was this asset purchased?"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                                             DisableFuture="true" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <!-- Warranty Information Card -->
                <MudCard Elevation="2" Class="form-card mt-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Verified" Class="mr-2" Color="Color.Success" />
                                <MudText Typo="Typo.h6">Warranty Information</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="asset.WarrantyTypeId" 
                                         Label="Warranty Type" 
                                         @bind-Value:after="OnChangeWarrantyType"
                                         Variant="Variant.Outlined"
                                         AnchorOrigin="Origin.BottomCenter"
                                         HelperText="Select warranty type if applicable">
                                    <MudSelectItem Value="@(null as Guid?)">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Block" Class="mr-2" Size="Size.Small" />
                                            -- No Warranty --
                                        </div>
                                    </MudSelectItem>
                                    @foreach (var wt in warrantyTypes)
                                    {
                                        <MudSelectItem Value="@(wt.Id as Guid?)">
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.Verified" Class="mr-2" Size="Size.Small" />
                                                @wt.Name
                                            </div>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            
                            <MudItem xs="12" md="6">
                                <MudDatePicker @bind-Date="asset.WarrantyExpiration" 
                                             Label="Warranty Expiration" 
                                             Variant="Variant.Outlined"
                                             HelperText="When does the warranty expire?"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.Event"
                                             Disabled="asset.WarrantyTypeId == null" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <!-- Attributes Card -->
                <MudCard Elevation="2" Class="form-card mt-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Extension" Class="mr-2" Color="Color.Info" />
                                <MudText Typo="Typo.h6">Attributes</MudText>
                            </div>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudTooltip Text="Add attribute">
                                <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                             Color="Color.Primary" 
                                             Size="Size.Medium"
                                             OnClick="AddAttribute" />
                            </MudTooltip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent Class="pa-0">
                        @if (_attributes.Any())
                        {
                            <MudStack Style="gap: 0">
                                @foreach (var attr in _attributes)
                                {
                                    <MudCard Elevation="0" Class="attribute-card">
                                        <MudCardContent Class="px-4 pt-1 pb-1">
                                            <MudGrid Spacing="2" AlignItems="Center">
                                                <MudItem xs="12" sm="5">
                                                    <MudTextField @bind-Value="attr.Attribute" 
                                                                Label="Attribute Name" 
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="10" sm="5">
                                                    <MudTextField @bind-Value="attr.Value" 
                                                        Label="Value" 
                                                        Variant="Variant.Outlined"
                                                        Margin="Margin.Dense"
                                                        Required="@(!string.IsNullOrWhiteSpace(attr.Attribute) && string.IsNullOrWhiteSpace(attr.Value))"
                                                        Error="@(!string.IsNullOrWhiteSpace(attr.Attribute) && string.IsNullOrWhiteSpace(attr.Value))"
                                                        ErrorText="Value is required if Attribute is set." />
                                                </MudItem>
                                                <MudItem xs="2" sm="2" Class="d-flex justify-end">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                                 Color="Color.Error"
                                                                 Size="Size.Small" 
                                                                 OnClick="@(() => _attributes.Remove(attr))" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center py-6">
                                <MudIcon Icon="@Icons.Material.Filled.ExtensionOff" Size="Size.Large" Class="mud-text-secondary mb-2" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">No attributes added</MudText>
                                <MudButton Color="Color.Primary" 
                                         Variant="Variant.Text" 
                                         StartIcon="@Icons.Material.Filled.Add"
                                         OnClick="AddAttribute">
                                    Add First Attribute
                                </MudButton>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Attachments Sidebar -->
            <MudItem xs="12" lg="4">
                <MudCard Elevation="2" Class="form-card attachments-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-2" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">Attachments</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        <!-- Upload Buttons -->
                        <MudStack Spacing="2" Class="mb-4">
                            @if (IsMobile)
                            {
                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                             FilesChanged="AddAttachment"
                                             accept="image/*" 
                                             Capture="environment">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled"
                                                 Color="Color.Primary"
                                                 StartIcon="@Icons.Material.Filled.Camera"
                                                 FullWidth="true"
                                                 Class="upload-btn">
                                            Take Photo
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                
                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                             FilesChanged="AddAttachment"
                                             accept="image/*">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined"
                                                 Color="Color.Primary"
                                                 StartIcon="@Icons.Material.Filled.Image"
                                                 FullWidth="true"
                                                 Class="upload-btn">
                                            From Gallery
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            }
                            else
                            {
                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                             FilesChanged="AddAttachment"
                                             accept="image/*,application/pdf">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled"
                                                 Color="Color.Primary"
                                                 StartIcon="@Icons.Material.Filled.CloudUpload"
                                                 FullWidth="true"
                                                 Class="upload-btn"
                                                 Disabled="_uploading">
                                            @if (_uploading)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                <span>Uploading...</span>
                                            }
                                            else
                                            {
                                                <span>Upload Files</span>
                                            }
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            }
                        </MudStack>

                        <!-- Attachments List -->
                        @if (_attachments.Any())
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-3">Attachments (@_attachments.Count)</MudText>
                            <MudStack Spacing="2" Elevation="0">
                                @foreach (var item in _attachments)
                                {
                                    <MudCard Elevation="0" Class="attachment-item">
                                        <MudCardContent >
                                            <div class="d-flex align-center justify-space-between">
                                                <div class="flex-grow-1 ">
                                                    <MudText Typo="Typo.body2" Class="text-truncate">
                                                        @item.attachment.OriginFileName
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                        @Formatter.FormatFileSize(item.attachment.FileSize) • @item.attachment.Extension.ToUpper()
                                                    </MudText>
                                                </div>
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                             Color="Color.Error"
                                                             Size="Size.Small"
                                                             OnClick="@(() => Remove(item))" />
                                            </div>
                                            
                                            <MudSelect T="Guid?"
                                                     @bind-Value="item.attachment.AttachmentTypeId"
                                                     Label="Type"
                                                     Dense="true"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Disabled="_uploading">
                                                @foreach (var type in attachmentTypes)
                                                {
                                                    <MudSelectItem T="Guid?" Value="@type.Id">@type.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center py-6 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Class="mud-text-secondary mb-2" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-1">No attachments yet</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Upload receipts, photos, or documents</MudText>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>

                @*
                <!-- Action Buttons -->
                <MudCard Elevation="2" Class="form-card mt-4">
                    <MudCardContent>
                        <MudStack Spacing="2">
                            <MudButton Color="Color.Primary" 
                                     Variant="Variant.Filled" 
                                     ButtonType="ButtonType.Submit"
                                     StartIcon="@Icons.Material.Filled.Save"
                                     FullWidth="true"
                                     Size="Size.Large"
                                     Class="action-btn">
                                Create Asset
                            </MudButton>
                            
                            <MudButton Color="Color.Default" 
                                     Variant="Variant.Outlined" 
                                     OnClick="GoBack"
                                     StartIcon="@Icons.Material.Filled.Cancel"
                                     FullWidth="true"
                                     Class="action-btn">
                                Cancel
                            </MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>*@
            </MudItem>
        </MudGrid>
        
        <!-- Validation Summary (if needed) -->
        <MudCollapse Expanded="@(_validationErrors.Any())">
            <MudAlert Severity="Severity.Error" Class="mt-4">
                <ValidationSummary />
            </MudAlert>
        </MudCollapse>
    </EditForm>
</MudContainer>

@code {
    private Asset asset = new() { PurchaseDate = DateTime.Today, WarrantyExpiration = DateTime.Today };
    private List<Category> categories = new();
    private List<WarrantyType> warrantyTypes = new();
    private static readonly Guid? nullGuid = null;

    private List<Attachment_wfile> _attachments = new();
    private List<AttributeValue> _attributes = new();
    private int maxAllowedFiles = 3;
    private bool _uploading = false;
    private List<string> _validationErrors = new();

    private List<AttachmentType> attachmentTypes = new();
    private Guid defaultAttachmentTypeId;
    private Guid defaultWarrantyTypeId;

    private bool IsMobile;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsMobile = CurrentUser.IsMobile;

            categories = (await CategoryService.GetAllAsync()).ToList();
            warrantyTypes = ((await WarrantyTypeService.GetAllAsync()).OrderBy(x => x.SortOrder)).ToList();
            attachmentTypes = (await AttachmentTypeService.GetAllAsync()).ToList();

            if (attachmentTypes.Count == 0)
            {
                Snackbar.Add("No attachment types found. Please create at least one attachment type.", Severity.Error);
                return;
            }

            defaultAttachmentTypeId = attachmentTypes.Where(at => at.Default).First().Id;
            defaultWarrantyTypeId = warrantyTypes.Where(wt => wt.Default).First().Id;

            if (asset.PurchaseDate == default)
                asset.PurchaseDate = DateTime.Today;

            asset.WarrantyTypeId = defaultWarrantyTypeId;
            OnChangeWarrantyType();

            _attributes.Add(new AttributeValue()); // Add initial empty attribute
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
            Logger.LogError(ex, "Error initializing CreateAsset components");
        }
    }

    private async Task AddAttribute()
    {
        _attributes.Add(new AttributeValue());
    }

    private void AddAttachment(IReadOnlyList<IBrowserFile> files)
    {
        _uploading = true;

        try
        {
            foreach (var file in files)
            {
                try
                {
                    var fileExtension = Path.GetExtension(file.Name);

                    // Save Attachment entity
                    var attachment = new Attachment
                        {
                            OriginFileName = file.Name,
                            Extension = fileExtension,
                            ContentType = file.ContentType,
                            FileSize = file.Size,
                            AttachmentTypeId = defaultAttachmentTypeId
                        };

                    Attachment_wfile attachmentWithFile = new Attachment_wfile
                        {
                            attachment = attachment,
                            file = file
                        };

                    _attachments.Add(attachmentWithFile);
                    Snackbar.Add($"File {file.Name} added for upload.", Severity.Success);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Failed to upload {file.Name}: {ex.Message}", Severity.Error);
                }
            }
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task Remove(Attachment_wfile item)
    {
        _attachments.Remove(item);
    }

    private async Task SaveAttachments(Guid Id)
    {
        try
        {
            foreach (var item in _attachments)
            {
                item.attachment.ParentId = Id;

                item.attachment.LocalFileName = await FileStorageService.UploadAsync<Asset>(item.file);

                var uploadedAttachment = await AttachmentService.AddAsync(item.attachment);
            }
            _attachments.Clear();
            Snackbar.Add($"Attachments Saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save attachments");
            Snackbar.Add($"Failed to save attachments: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAttributes(Guid Id)
    {
        try
        {
            foreach (var attr in _attributes.Where(a => !string.IsNullOrWhiteSpace(a.Attribute)))
            {
                attr.ParentId = Id;

                await AttributeService.AddAsync(attr);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save attributes");
            Snackbar.Add($"Failed to save attributes: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            // Set null for empty Guid selections
            if (asset.CategoryId == Guid.Empty) asset.CategoryId = null;
            if (asset.WarrantyTypeId == Guid.Empty) asset.WarrantyTypeId = null;

            var newAsset = await AssetService.AddAsync(asset);

            await SaveAttributes(newAsset.Id);
            await SaveAttachments(newAsset.Id);

            Snackbar.Add("Asset created successfully.", Severity.Success);
            Navigation.NavigateTo("/assets");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/assets");
    }

    struct Attachment_wfile
    {
        public Attachment attachment;
        public IBrowserFile file;
    }

    private async void OnChangeWarrantyType()
    {
        if (asset.WarrantyTypeId == nullGuid)
        {
            asset.WarrantyExpiration = null;
        }
        else
        {
            var warrantyType = warrantyTypes.Where(w => w.Id == asset.WarrantyTypeId).FirstOrDefault();
            if (warrantyType != null)
            {
                if (warrantyType.Years is not null)
                    asset.WarrantyExpiration = DateTime.Today.AddYears(warrantyType.Years.Value);
                if (warrantyType.Months is not null)
                    asset.WarrantyExpiration = DateTime.Today.AddMonths(warrantyType.Months.Value);
                if (warrantyType.Days is not null)
                    asset.WarrantyExpiration = DateTime.Today.AddDays(warrantyType.Days.Value);
            }
        }
        StateHasChanged();
    }
}
