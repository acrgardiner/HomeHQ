@page "/assets"
@using projectaardvarkx2.Entities
@using projectaardvarkx2.Services
@using System.Linq.Expressions
@using projectaardvarkx2.Components.Entities.Common
@using projectaardvarkx2.Helpers
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<Asset> AssetService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Asset_List_Page> Logger
@inject NavigationManager NavigationManager

<PageTitle>Assets - Home Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <!-- Header and actions -->
    <div class="d-flex align-center mb-6">
        <div class="flex-grow-1">
            <MudText Typo="Typo.h4" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.AccountBox" Class="mr-3" Size="Size.Large" />
                Assets Management
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Manage your assets, track warranties, and organize documentation
            </MudText>
        </div>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudFab Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenCreate"
                Class="entity-action-btn">
            </MudFab>
        </MudStack>
    </div>

    <!-- Statistics Cards -->
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="6" sm="4">
            <MudCard Elevation="2" Class="dashboard-card">
                <MudCardContent Class="pb-0">
                    <div class="d-flex justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Total Assets</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Primary">@_totalAssets</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Class="dashboard-avatar">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBox" />
                        </MudAvatar>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="6" sm="4">
            <MudCard Elevation="2" Class="dashboard-card">
                <MudCardContent Class="pb-0">
                    <div class="d-flex justify-space-between">
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Warranties Expiring</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Warning">@_warrantiesExpiring</MudText>
                        </div>
                        <MudAvatar Color="Color.Warning" Class="dashboard-avatar">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" />
                        </MudAvatar>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Main Content Card -->
    <MudCard Elevation="2" Class="assets-list-card">
        <EntityList TEntityType="Asset" 
                    Plural="Assets" 
                    Singular="Asset" 
                    EntityService="AssetService"
                    Logger="Logger"
                    Includes="@(Includes)"
                    Columns="@(
                        new List<(Func<Asset, object?>, string)>{
                            (new Func<Asset, object?>(x => x.Name), "Name"),
                            (new Func<Asset, object?>(x => x.Category?.Title ?? "Uncategorized"), "Category"),
                            (new Func<Asset, object?>(x => x.PurchasedFrom), "From"),
                            (new Func<Asset, object?>(x => Formatter.FormatDate(x.PurchaseDate, "MMM dd, yyyy")), "Purchase Date"),
                            (new Func<Asset, object?>(x => Formatter.RenderWarrantyInfo(x)), "Warranty"),
                        }
                    )"
                    ItemActions="AssetActions"
                    EnableItemDelete="false"
                    EnableExport="true"
                    OnRowClicked="@(RowClicked)">
            <ToolbarActions>
                <!-- Additional toolbar actions can go here -->
            </ToolbarActions>
        </EntityList>
    </MudCard>
</MudContainer>

@code {
    private List<EntityAction<Asset>>? AssetActions = null;

    private Func<Asset, Task> RowClicked => async (asset) => await OpenDetails(asset);

    private List<BreadcrumbItem> _breadcrumbItems = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Dashboard", href: "/", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("Assets", href: null, disabled: true, icon: Icons.Material.Filled.AccountBox),
    };

    // Stats
    private int _totalAssets = 0;
    private int _warrantiesExpiring = 0;
    private int _categoriesCount = 0;

    List<Expression<Func<Asset, object>>>? Includes => new List<Expression<Func<Asset, object>>>
    {
        x => x.Category,
        x => x.WarrantyType
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadStatistics();
    }

    private async Task LoadStatistics()
    {
        try
        {
            var assets = await AssetService.GetAllAsync(Includes);
            
            _totalAssets = assets.Count();
            
            // Count warranties expiring in next 30 days
            var thirtyDaysFromNow = DateTime.Today.AddDays(30);
            _warrantiesExpiring = assets.Where(a => a.WarrantyExpiration.HasValue && 
                                                   a.WarrantyExpiration.Value <= thirtyDaysFromNow &&
                                                   a.WarrantyExpiration.Value >= DateTime.Today).Count();
            
            // Get unique categories count
            _categoriesCount = assets.Where(a => a.Category != null).Select(a => a.CategoryId).Distinct().Count();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load asset statistics");
        }
    }

    private Task ShowGalleryAsync(Attachment attachment)
    {
        var param = new DialogParameters<ViewImage>()
        {
            { x => x.Attachment, attachment }
        };
        return DialogService.ShowAsync<ViewImage>("View Attachment", param);
    }

    private void OpenCreate()
    {
        NavigationManager.NavigateTo("/assets/create");
    }

    private async Task OpenDetails(Asset asset)
    {
        NavigationManager.NavigateTo($"/assets/{asset.Id}");
    }

    private async Task OpenEdit(Asset asset)
    {
        NavigationManager.NavigateTo($"/assets/edit/{asset.Id}");
    }
}


