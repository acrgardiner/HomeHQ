@page "/assets/edit/{Id:guid}"
@using projectaardvarkx2.Entities
@using projectaardvarkx2.Services
@using projectaardvarkx2.Helpers
@using projectaardvarkx2.FileStorage
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Authorization
@using projectaardvarkx2.Components.Entities.Common

@attribute [Authorize()]

@inject IEntityService<Asset> AssetService
@inject IEntityService<Category> CategoryService
@inject IEntityService<WarrantyType> WarrantyTypeService
@inject IEntityService<AttachmentType> AttachmentTypeService
@inject IEntityService<Attachment> AttachmentService
@inject IEntityService<AttributeValue> AttributeService
@inject IFileStorageService FileStorageService

@inject ICurrentUserService CurrentUser

@inject ISnackbar Snackbar
@inject ILogger<Asset_Edit_Page> Logger
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <EditForm Model="@asset" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <!-- Header -->
        <div class="d-flex align-center mb-6">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                          Size="Size.Medium"
                          OnClick="GoBack"
                          Class="mr-3" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.h4" Color="Color.Primary">Edit Asset</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Update asset information and manage attachments
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           StartIcon="@Icons.Material.Filled.Save"
                           Class="asset-action-btn">
                    Save
                </MudButton>
            </MudStack>
        </div>

        <MudGrid Spacing="4">
            <MudItem xs="12" lg="8">
                <!-- Basic Information Card -->
                <MudCard Elevation="2" Class="form-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Color="Color.Primary" />
                                <MudText Typo="Typo.h6">Basic Information</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        <MudGrid Spacing="3">
                            <MudItem xs="6">
                                <MudTextField @bind-Value="asset.Name"
                                    Label="Name"
                                    Required="true"
                                    Variant="Variant.Outlined"
                                    HelperText="Enter a descriptive name for your asset"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.Label" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="asset.CategoryId"
                                           T="Guid?"
                                           Label="Category"
                                           Required="true"
                                           Variant="Variant.Outlined"
                                           AnchorOrigin="Origin.BottomCenter"
                                           HelperText="Select the category that best describes this asset">
                                    <MudSelectItem Value="@(null as Guid?)">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-2" Size="Size.Small" />
                                            -- Select Category --
                                        </div>
                                    </MudSelectItem>
                                    @foreach (var cat in categories)
                                    {
                                        <MudSelectItem Value="@(cat.Id as Guid?)">
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@cat.Icon" Class="mr-2" Size="Size.Small" />
                                                @cat.Title
                                            </div>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField @bind-Value="asset.PurchasedFrom"
                                              Label="Purchased From"
                                              Required="true"
                                              Variant="Variant.Outlined"
                                              HelperText="Where did you buy this asset"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Store" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudDatePicker @bind-Date="asset.PurchaseDate" 
                                             Label="Purchase Date" 
                                             Required="true"
                                             Variant="Variant.Outlined"
                                             HelperText="When was this asset purchased?"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                                             DisableFuture="true" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <!-- Warranty Information Card -->
                <MudCard Elevation="2" Class="form-card mt-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Verified" Class="mr-2" Color="Color.Success" />
                                <MudText Typo="Typo.h6">Warranty Information</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="asset.WarrantyTypeId"
                                         Label="Warranty Type"
                                         @bind-Value:after="OnChangeWarrantyType"
                                         Variant="Variant.Outlined"
                                         AnchorOrigin="Origin.BottomCenter"
                                         HelperText="Select warranty type if applicable">
                                    <MudSelectItem Value="@(null as Guid?)">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Block" Class="mr-2" Size="Size.Small" />
                                            -- No Warranty --
                                        </div>
                                    </MudSelectItem>
                                    @foreach (var wt in warrantyTypes)
                                    {
                                        <MudSelectItem Value="@(wt.Id as Guid?)">
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.Verified" Class="mr-2" Size="Size.Small" />
                                                @wt.Name
                                            </div>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudDatePicker @bind-Date="asset.WarrantyExpiration"
                                             Label="Warranty Expiration"
                                             Variant="Variant.Outlined"
                                             HelperText="When does the warranty expire?"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.Event"
                                             Disabled="asset.WarrantyTypeId == null" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <!-- Attributes Card -->
                <MudCard Elevation="2" Class="form-card mt-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Extension" Class="mr-2" Color="Color.Info" />
                                <MudText Typo="Typo.h6">Attributes</MudText>
                            </div>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudTooltip Text="Add attribute">
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                             Color="Color.Primary"
                                             Size="Size.Medium"
                                             OnClick="AddAttribute" />
                            </MudTooltip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent Class="pa-0">
                        @if (_attributes.Any())
                        {
                            <MudStack Style="gap: 0">
                                @foreach (var attr in _attributes)
                                {
                                    <MudCard Elevation="0" Class="attribute-card">
                                        <MudCardContent Class="px-4 pt-1 pb-1">
                                            <MudGrid Spacing="2" AlignItems="Center">
                                                <MudItem xs="12" sm="5">
                                                    <MudTextField @bind-Value="attr.Attribute"
                                                                Label="Attribute"
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="10" sm="5">
                                                    <MudTextField @bind-Value="attr.Value"
                                                        Label="Value"
                                                        Variant="Variant.Outlined"
                                                        Margin="Margin.Dense"
                                                        Required="@(!string.IsNullOrWhiteSpace(attr.Attribute) && string.IsNullOrWhiteSpace(attr.Value))"
                                                        Error="@(!string.IsNullOrWhiteSpace(attr.Attribute) && string.IsNullOrWhiteSpace(attr.Value))"
                                                        ErrorText="Value is required if Attribute is set." />
                                                </MudItem>
                                                <MudItem xs="2" sm="2" Class="d-flex justify-end">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                 Color="Color.Error"
                                                                 Size="Size.Small"
                                                                 OnClick="@(() => Remove(attr))" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center py-6">
                                <MudIcon Icon="@Icons.Material.Filled.ExtensionOff" Size="Size.Large" Class="mud-text-secondary mb-2" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">No attributes added</MudText>
                                <MudButton Color="Color.Primary"
                                         Variant="Variant.Text"
                                         StartIcon="@Icons.Material.Filled.Add"
                                         OnClick="AddAttribute">
                                    Add First Attribute
                                </MudButton>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Attachments Sidebar -->
            <MudItem xs="12" lg="4">
                <MudCard Elevation="2" Class="form-card attachments-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-2" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">Attachments</MudText>
                            </div>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (_attachments.Any())
                            {
                                <div class="d-flex align-center">
                                    <MudText Typo="Typo.caption" Class="mr-3 mud-text-secondary">
                                        @(_currentAttachmentIndex + 1) of @_attachments.Count
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   Disabled="@(_currentAttachmentIndex <= 0)"
                                                   OnClick="PreviousAttachment" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   Disabled="@(_currentAttachmentIndex >= _attachments.Count - 1)"
                                                   OnClick="NextAttachment" />
                                </div>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        <!-- Upload Buttons -->
                        <MudStack Spacing="2" Class="mb-4">
                            @if (IsMobile)
                            {
                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                               FilesChanged="AddAttachment"
                                               accept="image/*"
                                               Capture="environment">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Camera"
                                                   FullWidth="true"
                                                   Class="upload-btn">
                                            Take Photo
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>

                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                               FilesChanged="AddAttachment"
                                               accept="image/*">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Image"
                                                   FullWidth="true"
                                                   Class="upload-btn">
                                            From Gallery
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            }
                            else
                            {
                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                               FilesChanged="AddAttachment"
                                               accept="image/*,application/pdf">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                                   FullWidth="true"
                                                   Class="upload-btn"
                                                   Disabled="_uploading">
                                            @if (_uploading)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                <span>Uploading...</span>
                                            }
                                            else
                                            {
                                                <span>Upload Files</span>
                                            }
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            }
                        </MudStack>
                        @if (_attachments.Any())
                        {
                            <div class="attachment-carousel">
                                @{
                                    var currentAttachment = _attachments[_currentAttachmentIndex].attachment;
                                }
                                <!-- Main Attachment Display -->
                                <div class="attachment-display mb-4" @onclick="@(() => ViewAttachment(currentAttachment))">
                                    @if (IsImageAttachment(currentAttachment))
                                    {
                                        <div class="attachment-preview image-preview">
                                            <MudImage Src="@GetAttachmentPreviewUrl(currentAttachment)"
                                                      Alt="@currentAttachment.OriginFileName"
                                                      Class="attachment-image"
                                                      ObjectFit="ObjectFit.Cover" />
                                            <div class="attachment-overlay">
                                                <MudIconButton Icon="@Icons.Material.Filled.ZoomIn"
                                                               Size="Size.Large"
                                                               Color="Color.Primary"
                                                               Variant="Variant.Filled"
                                                               Class="zoom-button" OnClick="@(() => NavigateToAttachment(currentAttachment))" />
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="attachment-preview file-preview">
                                            <div class="file-icon-container">
                                                <MudIcon Icon="@GetAttachmentIcon(currentAttachment)"
                                                         Size="Size.Large"
                                                         Color="Color.Primary" />
                                            </div>
                                            <div class="attachment-overlay">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                               Size="Size.Large"
                                                               Color="Color.Primary"
                                                               Variant="Variant.Filled"
                                                               Class="view-button" />
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Attachment Info -->
                                <div class="attachment-info mb-3">
                                    <div class="d-flex align-center justify-space-between mb-2">
                                        <MudText Typo="Typo.subtitle1" Class="attachment-name text-truncate">
                                            @currentAttachment.OriginFileName
                                        </MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Variant="Variant.Text"
                                                       />
                                    </div>

                                    <div class="d-flex align-center justify-space-between">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @Formatter.FormatFileSize(currentAttachment.FileSize) • @currentAttachment.Extension?.ToUpper()
                                        </MudText>
                                        @if (currentAttachment.AttachmentType != null)
                                        {
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="Color.Secondary"
                                                     Variant="Variant.Text">
                                                @currentAttachment.AttachmentType.Name
                                            </MudChip>
                                        }
                                    </div>
                                </div>
                                <!-- Thumbnail Navigation (if more than one attachment) -->
                                @if (_attachments.Count > 1)
                                {
                                    <div class="attachment-thumbnails">
                                        <MudStack Row="true" Spacing="1" Justify="Justify.Center">
                                            @for (int i = 0; i < _attachments.Count; i++)
                                            {
                                                var index = i; // Capture for closure
                                                var attachment = _attachments[i];
                                                var isActive = i == _currentAttachmentIndex;

                                                <div class="thumbnail-container @(isActive ? "active" : "")"
                                                    @onclick="@(() => SetCurrentAttachment(index))">
                                                    @if (IsImageAttachment(attachment.attachment))
                                                    {
                                                        <MudImage Src="@GetAttachmentPreviewUrl(attachment.attachment)"
                                                                  Alt="@attachment.attachment.OriginFileName"
                                                                  Class="thumbnail-image"
                                                                  ObjectFit="ObjectFit.Cover" />
                                                    }
                                                    else
                                                    {
                                                        <div class="thumbnail-file">
                                                            <MudIcon Icon="@GetAttachmentIcon(attachment.attachment)"
                                                                     Size="Size.Small"
                                                                     Color="Color.Primary" />
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </MudStack>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center py-6 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Class="mud-text-secondary mb-2" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-1">No attachments yet</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Upload receipts, photos, or documents</MudText>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
        
        <!-- Validation Summary (if needed) -->
        <MudCollapse Expanded="@(_validationErrors.Any())">
            <MudAlert Severity="Severity.Error" Class="mt-4">
                <ValidationSummary />
            </MudAlert>
        </MudCollapse>
    </EditForm>
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    private Asset asset = new();
    private List<Category> categories = new();
    private List<WarrantyType> warrantyTypes = new();
    private static readonly Guid? nullGuid = null;

    private List<Attachment_wfile> _attachments = new();
    private List<AttributeValue> _attributes = new();
    private int maxAllowedFiles = 3;
    private bool _uploading = false;
    private List<string> _validationErrors = new();

    private List<AttachmentType> attachmentTypes = new();
    private Guid defaultAttachmentTypeId;
    private Guid defaultWarrantyTypeId;

    private int _currentAttachmentIndex = 0;

    private bool IsMobile;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsMobile = CurrentUser.IsMobile;

            categories = (await CategoryService.GetAllAsync()).ToList();
            warrantyTypes = ((await WarrantyTypeService.GetAllAsync()).OrderBy(x => x.SortOrder)).ToList();
            attachmentTypes = (await AttachmentTypeService.GetAllAsync()).ToList();

            if (attachmentTypes.Count == 0)
            {
                Snackbar.Add("No attachment types found. Please create at least one attachment type.", Severity.Error);
                return;
            }

            defaultAttachmentTypeId = attachmentTypes.Where(at => at.Default).First().Id;
            defaultWarrantyTypeId = warrantyTypes.Where(wt => wt.Default).First().Id;

            var loadedAsset = await AssetService.GetByIdAsync(Id);
            if (loadedAsset == null)
            {
                Snackbar.Add("Asset not found.", Severity.Error);
                Navigation.NavigateTo("/assets");
                return;
            }
            asset = loadedAsset;

            var existingAttachments = (await AttachmentService.GetAsync(
                filter: x => x.ParentId == Id,
                orderby: x => x.CreatedOn,
                descending: true,
                includes: new List<Expression<Func<Attachment, object>>> { x => x.AttachmentType }
            )).ToList();
            _attachments = existingAttachments.Select(a => new Attachment_wfile { attachment = a, file = null }).ToList();
            _attributes = (await AttributeService.GetAsync(
                filter: x => x.ParentId == Id
            )).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
            Logger.LogError(ex, "Error initializing EditAsset components");
        }
    }

    private void AddAttachment(IReadOnlyList<IBrowserFile> files)
    {
        _uploading = true;

        try
        {
            foreach (var file in files)
            {
                try
                {
                    var fileExtension = Path.GetExtension(file.Name);

                    // Save Attachment entity
                    var attachment = new Attachment
                        {
                            OriginFileName = file.Name,
                            Extension = fileExtension,
                            ContentType = file.ContentType,
                            FileSize = file.Size,
                            AttachmentTypeId = defaultAttachmentTypeId
                        };

                    Attachment_wfile attachmentWithFile = new Attachment_wfile
                        {
                            attachment = attachment,
                            file = file
                        };

                    _attachments.Add(attachmentWithFile);
                    Snackbar.Add($"File {file.Name} added for upload.", Severity.Success);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, $"Failed to prepare file {file.Name} for upload");
                    Snackbar.Add($"Failed to upload {file.Name}", Severity.Error);
                }
            }
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task Remove(Attachment_wfile item)
    {
        _attachments.Remove(item);
        // Optionally, delete from server if item.attachment.Id != Guid.Empty
        if (item.attachment.Id != Guid.Empty)
        {
            await AttachmentService.DeleteAsync(item.attachment.Id);
        }
    }

    private async Task Remove(AttributeValue item)
    {
        _attributes.Remove(item);
        // Optionally, delete from server if item.attachment.Id != Guid.Empty
        if (item.Id != Guid.Empty)
        {
            await AttributeService.DeleteAsync(item.Id);
        }
    }

    private async Task AddAttribute()
    {
        _attributes.Add(new AttributeValue());
    }

    private async Task SaveAttachments(Guid Id)
    {
        try
        {
            foreach (var item in _attachments.Where(x => x.file != null))
            {
                item.attachment.ParentId = Id;
                item.attachment.ParentType = typeof(Asset).Name;
                item.attachment.LocalFileName = await FileStorageService.UploadAsync<Asset>(item.file);

                var uploadedAttachment = await AttachmentService.AddAsync(item.attachment);
            }
            Snackbar.Add($"Attachments Saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save attachments");
            Snackbar.Add($"Failed to save attachments: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (asset.CategoryId == Guid.Empty) asset.CategoryId = null;
            if (asset.WarrantyTypeId == Guid.Empty) asset.WarrantyTypeId = null;

            await AssetService.UpdateAsync(asset);
            await SaveAttributes(asset.Id);
            await SaveAttachments(asset.Id);

            Snackbar.Add("Asset updated successfully.", Severity.Success);
            Navigation.NavigateTo("/assets");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/assets");
    }

    struct Attachment_wfile
    {
        public Attachment attachment;
        public IBrowserFile? file;
    }

    private void OnChangeWarrantyType()
    {
        if (asset.WarrantyTypeId == nullGuid)
        {
            asset.WarrantyExpiration = null;
        }
        else
        {
            var warrantyType = warrantyTypes.Where(w => w.Id == asset.WarrantyTypeId).FirstOrDefault();
            if (warrantyType != null)
            {
                if (warrantyType.Years is not null)
                    asset.WarrantyExpiration = DateTime.Today.AddYears(warrantyType.Years.Value);
                if (warrantyType.Months is not null)
                    asset.WarrantyExpiration = DateTime.Today.AddMonths(warrantyType.Months.Value);
                if (warrantyType.Days is not null)
                    asset.WarrantyExpiration = DateTime.Today.AddDays(warrantyType.Days.Value);
            }
        }
        StateHasChanged();
    }

    private async Task SaveAttributes(Guid Id)
    {
        try
        {
            foreach (var attr in _attributes.Where(a => !string.IsNullOrWhiteSpace(a.Attribute)))
            {
                if (attr.Id == Guid.Empty)
                {
                    attr.ParentId = Id;
                    await AttributeService.AddAsync(attr);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save attributes");
            Snackbar.Add($"Failed to save attributes: {ex.Message}", Severity.Error);
        }
    }

    private void NextAttachment()
    {
        if (_currentAttachmentIndex < _attachments.Count - 1)
        {
            _currentAttachmentIndex++;
        }
    }

    private void PreviousAttachment()
    {
        if (_currentAttachmentIndex > 0)
        {
            _currentAttachmentIndex--;
        }
    }

    private void SetCurrentAttachment(int index)
    {
        if (index >= 0 && index < _attachments.Count)
        {
            _currentAttachmentIndex = index;
        }
    }

    private async Task ViewAttachment(Attachment attachment)
    {
        try
        {
            //This would ideally open the attachment in a dialog or new tab
            var parameters = new DialogParameters<ViewImage>()
            {
                { x => x.Attachment, attachment }
            };
            await DialogService.ShowAsync<ViewImage>("View Attachment", parameters);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to view attachment {AttachmentId}", attachment.Id);
            Snackbar.Add("Failed to view attachment", Severity.Error);
        }
    }


    private bool IsImageAttachment(Attachment attachment)
    {
        return !string.IsNullOrEmpty(attachment.ContentType) && attachment.ContentType.StartsWith("image/");
    }

    private string GetAttachmentPreviewUrl(Attachment attachment)
    {
        return $"/api/uploads/{attachment.Id}/preview";
    }

    private async Task NavigateToAttachment(Attachment attachment)
    {
        await JSRuntime.InvokeVoidAsync("open", "/api/uploads/" + attachment.Id.ToString(), "_blank");
    }

    private async Task DownloadAttachment(Attachment attachment)
    {
        try
        {
            //This would ideally trigger a download
            Snackbar.Add($"Download started for {attachment.OriginFileName}", Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download attachment {AttachmentId}", attachment.Id);
            Snackbar.Add("Failed to download attachment", Severity.Error);
        }
    }

    private string GetAttachmentIcon(Attachment attachment)
    {
        if (string.IsNullOrEmpty(attachment.ContentType))
            return Icons.Material.Filled.AttachFile;

        return attachment.ContentType.StartsWith("image/") switch
        {
            true => Icons.Material.Filled.Image,
            false when attachment.ContentType.Contains("pdf") => Icons.Material.Filled.PictureAsPdf,
            false when attachment.ContentType.Contains("document") => Icons.Material.Filled.Description,
            false when attachment.ContentType.Contains("spreadsheet") => Icons.Material.Filled.GridOn,
            _ => Icons.Material.Filled.AttachFile
        };
    }
}