@page "/assets/{id}"
@using projectaardvarkx2.Entities
@using projectaardvarkx2.Services
@using projectaardvarkx2.Helpers
@using projectaardvarkx2.Components.Entities.Common
@using Microsoft.AspNetCore.Authorization
@using System.Linq.Expressions

@attribute [Authorize()]

@inject IEntityService<Asset> AssetService
@inject IEntityService<AttributeValue> AttributeService
@inject IEntityService<Attachment> AttachmentService

@inject ISnackbar Snackbar
@inject ILogger<Asset_Detail_Page> Logger
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>@(asset?.Name ?? "Asset Details")- Home Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <!-- Header -->
    <div class="d-flex align-center mb-6">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                      Size="Size.Medium" 
                      OnClick="GoBack" 
                      Class="mr-3" />
        <div class="flex-grow-1">
            <MudText Typo="Typo.h4" Color="Color.Primary">@(asset?.Name ?? "Asset Details")</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                View asset details, warranty information, and attachments
            </MudText>
        </div>
        
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary" 
                      StartIcon="@Icons.Material.Filled.Edit" 
                      OnClick="OpenEdit"
                       Class="entity-action-btn">
                Edit
            </MudButton>
            
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error" 
                      StartIcon="@Icons.Material.Filled.Delete" 
                      OnClick="OpenDeleteDialog"
                       Class="entity-action-btn">
                Delete
            </MudButton>
        </MudStack>
    </div>

    @if (_loading)
    {
        <MudStack Spacing="4">
            <MudSkeleton Animation="Animation.Wave" Height="200px" />
            <MudSkeleton Animation="Animation.Wave" Height="150px" />
            <MudSkeleton Animation="Animation.Wave" Height="150px" />
        </MudStack>
    }
    else if (asset == null)
    {
        <MudCard Elevation="2" Class="text-center pa-8">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
            <MudText Typo="Typo.h6" Class="mb-2">Asset Not Found</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                The asset you're looking for doesn't exist or has been deleted.
            </MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GoBack">
                Back to Assets
            </MudButton>
        </MudCard>
    }
    else
    {
        <MudGrid Spacing="4">
            <!-- Basic Information Card -->
            <MudItem xs="12" lg="8">
                <MudCard Elevation="2" Class="form-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Color="Color.Primary" />
                                <MudText Typo="Typo.h6">Basic Information</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        <MudGrid Spacing="3">
                            <MudItem xs="6">
                                <div class="entity-field">
                                    <MudText Typo="Typo.caption" Class="entity-label">Name</MudText>
                                    <MudText Typo="Typo.body1" Class="entity-value">@asset.Name</MudText>
                                </div>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <div class="entity-field">
                                    <MudText Typo="Typo.caption" Class="entity-label">Category</MudText>
                                    <div class="d-flex">
                                        <MudText Typo="Typo.body1" Class="entity-value">
                                            @(asset.Category?.Title ?? "Uncategorized")
                                        </MudText>
                                    </div>
                                </div>
                            </MudItem>
                            <MudItem xs="6">
                                <div class="entity-field">
                                    <MudText Typo="Typo.caption" Class="entity-label">Purchased From</MudText>
                                    <MudText Typo="Typo.body1" Class="entity-value">@asset.PurchasedFrom</MudText>
                                </div>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <div class="entity-field">
                                    <MudText Typo="Typo.caption" Class="entity-label">Purchase Date</MudText>
                                    <MudText Typo="Typo.body1" Class="entity-value">
                                        @(asset.PurchaseDate?.ToString("MMMM dd, yyyy") ?? "Not specified")
                                    </MudText>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <!-- Warranty Information Card -->
                <MudCard Elevation="2" Class="form-card mt-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Verified" Class="mr-2" Color="@GetWarrantyStatusColor()" />
                                <MudText Typo="Typo.h6">Warranty Information</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <div class="entity-field">
                                    <MudText Typo="Typo.caption" Class="entity-label">Warranty Type</MudText>
                                    <MudText Typo="Typo.body1" Class="entity-value">
                                        @(asset.WarrantyType?.Name ?? "No warranty")
                                    </MudText>
                                </div>
                            </MudItem>
                            
                            <MudItem xs="12" md="6">
                                <div class="entity-field">
                                    <MudText Typo="Typo.caption" Class="entity-label">Warranty Expiration</MudText>
                                    @if (asset.WarrantyExpiration.HasValue)
                                    {
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@GetWarrantyIcon()" 
                                                    Size="Size.Small" 
                                                    Color="@GetWarrantyStatusColor()" 
                                                    Class="mr-2" />
                                            <div>
                                                <MudText Typo="Typo.body1" Class="entity-value">
                                                    @asset.WarrantyExpiration.Value.ToString("MMMM dd, yyyy")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="@GetWarrantyStatusColor()">
                                                    @GetWarrantyStatusText()
                                                </MudText>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body1" Class="entity-value mud-text-secondary">
                                            Not specified
                                        </MudText>
                                    }
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <!-- Attributes Card -->
                <MudCard Elevation="2" Class="form-card mt-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Extension" Class="mr-2" Color="Color.Info" />
                                <MudText Typo="Typo.h6">Attributes</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        @if (_attributes.Any())
                        {
                            <MudStack Style="gap: 0">
                                @foreach (var attr in _attributes)
                                {
                                    <MudCard Elevation="0" Class="attribute-card">
                                        <MudCardContent Class="px-4 pt-1 pb-1">
                                            <MudGrid Spacing="2" AlignItems="Center">
                                                <MudItem xs="12" sm="5">
                                                    <MudText Typo="Typo.body1" Class="entity-value">@attr.Attribute</MudText>
                                                </MudItem>
                                                <MudItem xs="10" sm="5">
                                                    <MudText Typo="Typo.body1" Class="entity-value">@attr.Value</MudText>
                                                </MudItem>
                                            </MudGrid>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center py-6">
                                <MudIcon Icon="@Icons.Material.Filled.ExtensionOff" Size="Size.Large" Class="mud-text-secondary mb-2" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">No attributes</MudText>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="4">
                <!-- Attachments Card -->
                <MudCard Elevation="2" Class="form-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-2" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">Attachments</MudText>
                            </div>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (_attachments.Any())
                            {
                                <div class="d-flex align-center">
                                    <MudText Typo="Typo.caption" Class="mr-3 mud-text-secondary">
                                        @(_currentAttachmentIndex + 1) of @_attachments.Count
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                                    Size="Size.Small"
                                                    Color="Color.Primary"
                                                    Disabled="@(_currentAttachmentIndex <= 0)"
                                                    OnClick="PreviousAttachment" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                                    Size="Size.Small"
                                                    Color="Color.Primary"
                                                    Disabled="@(_currentAttachmentIndex >= _attachments.Count - 1)"
                                                    OnClick="NextAttachment" />
                                </div>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        @if (_attachments.Any())
                        {
                            <div class="attachment-carousel">
                                @{
                                    var currentAttachment = _attachments[_currentAttachmentIndex];
                                }
                                <!-- Main Attachment Display -->
                                <div class="attachment-display mb-4" @onclick="@(() => ViewAttachment(currentAttachment))">
                                    @if (IsImageAttachment(currentAttachment))
                                    {
                                        <div class="attachment-preview image-preview">
                                            <MudImage Src="@GetAttachmentPreviewUrl(currentAttachment)"
                                                    Alt="@currentAttachment.OriginFileName"
                                                    Class="attachment-image"
                                                    ObjectFit="ObjectFit.Cover" />
                                            <div class="attachment-overlay">
                                                <MudIconButton Icon="@Icons.Material.Filled.ZoomIn"
                                                             Size="Size.Large"
                                                             Color="Color.Primary"
                                                             Variant="Variant.Filled"
                                                               Class="zoom-button" OnClick="@(() => NavigateToAttachment(currentAttachment))" />
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="attachment-preview file-preview">
                                            <div class="file-icon-container">
                                                <MudIcon Icon="@GetAttachmentIcon(currentAttachment)"
                                                        Size="Size.Large"
                                                        Color="Color.Primary" />
                                            </div>
                                            <div class="attachment-overlay">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                             Size="Size.Large" 
                                                             Color="Color.Primary"
                                                             Variant="Variant.Filled"
                                                             Class="view-button" />
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Attachment Info -->
                                <div class="attachment-info mb-3">
                                    <div class="d-flex align-center justify-space-between mb-2">
                                        <MudText Typo="Typo.subtitle1" Class="attachment-name text-truncate">
                                            @currentAttachment.OriginFileName
                                        </MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Download" 
                                                     Size="Size.Small" 
                                                     Color="Color.Primary"
                                                     Variant="Variant.Text"
                                                     OnClick="@(() => DownloadAttachment(currentAttachment))" />
                                    </div>
                                    
                                    <div class="d-flex align-center justify-space-between">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @Formatter.FormatFileSize(currentAttachment.FileSize) • @currentAttachment.Extension?.ToUpper()
                                        </MudText>
                                        @if (currentAttachment.AttachmentType != null)
                                        {
                                            <MudChip T="string" Size="Size.Small" 
                                                   Color="Color.Secondary" 
                                                   Variant="Variant.Text">
                                                @currentAttachment.AttachmentType.Name
                                            </MudChip>
                                        }
                                    </div>
                                </div>

                                <!-- Thumbnail Navigation (if more than one attachment) -->
                                @if (_attachments.Count > 1)
                                {
                                    <div class="attachment-thumbnails">
                                        <MudStack Row="true" Spacing="1" Justify="Justify.Center">
                                            @for (int i = 0; i < _attachments.Count; i++)
                                            {
                                                var index = i; // Capture for closure
                                                var attachment = _attachments[i];
                                                var isActive = i == _currentAttachmentIndex;
                                                
                                                <div class="thumbnail-container @(isActive ? "active" : "")" 
                                                     @onclick="@(() => SetCurrentAttachment(index))">
                                                    @if (IsImageAttachment(attachment))
                                                    {
                                                        <MudImage Src="@GetAttachmentPreviewUrl(attachment)" 
                                                                Alt="@attachment.OriginFileName"
                                                                Class="thumbnail-image" 
                                                                ObjectFit="ObjectFit.Cover" />
                                                    }
                                                    else
                                                    {
                                                        <div class="thumbnail-file">
                                                            <MudIcon Icon="@GetAttachmentIcon(attachment)" 
                                                                   Size="Size.Small" 
                                                                   Color="Color.Primary" />
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </MudStack>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center py-6 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Class="mud-text-secondary mb-2" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">No attachments</MudText>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

    @code{
    [Parameter] public string Id { get; set; } = string.Empty;

    private Asset? asset;
    private List<AttributeValue> _attributes = new();
    private List<Attachment> _attachments = new();
    private bool _loading = true;
    private int _currentAttachmentIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAssetData();
    }

    private async Task LoadAssetData()
    {
        try
        {
            _loading = true;
            var guid = Guid.Parse(Id);

            // Load asset with related data
            asset = await AssetService.GetByIdAsync(guid, new List<Expression<Func<Asset, object>>>
            {
                x => x.Category,
                x => x.WarrantyType
            });

            if (asset != null)
            {
                // Load attributes and attachments in parallel
                var attributesTask = AttributeService.GetAsync(
                    filter: x => x.ParentId == guid
                );

                var attachmentsTask = AttachmentService.GetAsync(
                    filter: x => x.ParentId == guid,
                    orderby: x => x.CreatedOn,
                    descending: true,
                    includes: new List<Expression<Func<Attachment, object>>> { x => x.AttachmentType }
                );

                await Task.WhenAll(attributesTask, attachmentsTask);

                _attributes = attributesTask.Result.ToList();
                _attachments = attachmentsTask.Result.ToList();

                // Reset attachment index when loading new data
                _currentAttachmentIndex = 0;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading asset data for ID: {AssetId}", Id);
            Snackbar.Add($"Error loading asset: {ex.Message}", Severity.Error);
            asset = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private Color GetWarrantyStatusColor()
    {
        if (!asset?.WarrantyExpiration.HasValue ?? true)
            return Color.Default;

        var today = DateTime.Today;
        var warrantyDate = asset.WarrantyExpiration.Value;
        var daysRemaining = (warrantyDate - today).Days;

        return (daysRemaining switch
        {
            < 0 => Color.Default,
            <= 30 => Color.Warning,
            _ => Color.Success
        });
    }

    private string GetWarrantyIcon()
    {
        if (!asset?.WarrantyExpiration.HasValue ?? true)
            return Icons.Material.Filled.Block;

        var today = DateTime.Today;
        var warrantyDate = asset.WarrantyExpiration.Value;
        var daysRemaining = (warrantyDate - today).Days;

        return (daysRemaining switch
        {
            < 0 => Icons.Material.Filled.ErrorOutline,
            <= 30 => Icons.Material.Filled.Warning,
            _ => Icons.Material.Filled.CheckCircleOutline
        });
    }

    private string GetWarrantyStatusText()
    {
        if (!asset?.WarrantyExpiration.HasValue ?? true)
            return "No warranty";

        var today = DateTime.Today;
        var warrantyDate = asset.WarrantyExpiration.Value;
        var daysRemaining = (warrantyDate - today).Days;

        return (daysRemaining switch
        {
            < 0 => $"Expired {Math.Abs(daysRemaining)} days ago",
            0 => "Expires today",
            1 => "Expires tomorrow",
            <= 30 => $"Expires in {daysRemaining} days",
            _ => $"{daysRemaining} days remaining"
        });
    }

    private string GetAttachmentIcon(Attachment attachment)
    {
        if (string.IsNullOrEmpty(attachment.ContentType))
            return Icons.Material.Filled.AttachFile;

        return attachment.ContentType.StartsWith("image/") switch
        {
            true => Icons.Material.Filled.Image,
            false when attachment.ContentType.Contains("pdf") => Icons.Material.Filled.PictureAsPdf,
            false when attachment.ContentType.Contains("document") => Icons.Material.Filled.Description,
            false when attachment.ContentType.Contains("spreadsheet") => Icons.Material.Filled.GridOn,
            _ => Icons.Material.Filled.AttachFile
        };
    }

    private bool IsImageAttachment(Attachment attachment)
    {
        return !string.IsNullOrEmpty(attachment.ContentType) && attachment.ContentType.StartsWith("image/");
    }

    private string GetAttachmentPreviewUrl(Attachment attachment)
    {
        return $"/api/uploads/{attachment.Id}/preview";
    }

    private void NextAttachment()
    {
        if (_currentAttachmentIndex < _attachments.Count - 1)
        {
            _currentAttachmentIndex++;
        }
    }

    private void PreviousAttachment()
    {
        if (_currentAttachmentIndex > 0)
        {
            _currentAttachmentIndex--;
        }
    }

    private void SetCurrentAttachment(int index)
    {
        if (index >= 0 && index < _attachments.Count)
        {
            _currentAttachmentIndex = index;
        }
    }

    private async Task ViewAttachment(Attachment attachment)
    {
        try
        {
            //This would ideally open the attachment in a dialog or new tab
            var parameters = new DialogParameters<ViewImage>()
            {
                { x => x.Attachment, attachment }
            };
            await DialogService.ShowAsync<ViewImage>("View Attachment", parameters);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to view attachment {AttachmentId}", attachment.Id);
            Snackbar.Add("Failed to view attachment", Severity.Error);
        }
    }

    private async Task NavigateToAttachment(Attachment attachment)
    {
        await JSRuntime.InvokeVoidAsync("open", "/api/uploads/" + attachment.Id.ToString(), "_blank");
    }

    private async Task DownloadAttachment(Attachment attachment)
    {
        try
        {
            //This would ideally trigger a download
            Snackbar.Add($"Download started for {attachment.OriginFileName}", Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download attachment {AttachmentId}", attachment.Id);
            Snackbar.Add("Failed to download attachment", Severity.Error);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/assets");
    }

    private async Task OpenEdit()
    {
        if (asset != null)
        {
            Navigation.NavigateTo($"/assets/edit/{asset.Id}");
        }
    }

    @* Delete Dialog  *@
    public async Task OpenDeleteDialog()
    {
        if (asset == null) return;

        var parameters = new DialogParameters
        {
            ["Id"] = asset.Id,
            ["Message"] = $"Are you sure you want to delete '{asset.Name}'? This action cannot be undone."
        };

        var dialog = await DialogService.ShowAsync<DeleteConfirmation>("Confirm Deletion", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await AssetService.DeleteAsync(asset.Id);
                Snackbar.Add($"Asset '{asset.Name}' deleted successfully", Severity.Success);
                Navigation.NavigateTo("/assets");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to delete asset {AssetId}", asset.Id);
                Snackbar.Add($"Failed to delete asset", Severity.Error);
            }
        }
    }
}