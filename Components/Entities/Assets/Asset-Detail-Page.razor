@page "/assets/{id}"
@using projectaardvarkx2.Entities
@using projectaardvarkx2.Services
@using projectaardvarkx2.Helpers
@using projectaardvarkx2.Components.Entities.Common

@inject IEntityService<Asset> AssetService

@inject ISnackbar Snackbar
@inject ILogger<Asset_Detail_Page> Logger
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudToolBar Gutters="false">
        <MudText Typo="Typo.h5">Asset</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Info" OnClick="OpenEdit"/>
        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="OpenDeleteDialog" />
    </MudToolBar>
    <MudGrid>
        <MudFlexBreak />
        <MudItem xs="2">
            <MudText Color="Color.Primary" >Name:</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudText >@asset?.Name</MudText>
        </MudItem>
        <MudItem xs="2">
            <MudText Color="Color.Primary">Category</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudText>@asset?.Category?.Title</MudText>
        </MudItem>
        <MudItem xs="2">
            <MudText Color="Color.Primary">Purchase Date:</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudText>@(Formatter.FormatDate(asset?.PurchaseDate))</MudText>
        </MudItem>
        <MudItem xs="2">
            <MudText Color="Color.Primary">Purchase Amount:</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudText>@asset?.PurchaseAmount</MudText>
        </MudItem>
        <MudItem xs="2">
            <MudText Color="Color.Primary">Warranty Type:</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudText>@asset?.WarrantyType?.Name</MudText>
        </MudItem>
        <MudItem xs="2">
            <MudText Color="Color.Primary">Warranty Expiration:</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudText> @(Formatter.FormatDate(asset?.WarrantyExpiration))</MudText>
        </MudItem>
    </MudGrid>

    <AttributeList_view ParentId="@asset?.Id"/>

    <AttachmentList_view ParentId="@asset?.Id" />
</MudContainer>

@code{
    [Parameter]public string Id { get; set; }

    private Asset? asset = new Asset();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var guid = Guid.Parse(Id);
            asset = await AssetService.GetByIdAsync(guid, new() { x => x.Category, x => x.WarrantyType});
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
    }

    @* Delete Dialog  *@
    public async Task OpenDeleteDialog()
    {
        var parameters = new DialogParameters
            {
                ["Id"] = asset.Id,
                ["Message"] = $"Are you sure you want to delete this Asset? This action cannot be undone."
            };

        var dialog = await DialogService.ShowAsync<DeleteConfirmation>("Confirm Deletion", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await AssetService.DeleteAsync(asset.Id);
                Snackbar.Add($"Asset deleted successfully", Severity.Success);
                Navigation.NavigateTo("/assets");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to delete asset");
                Snackbar.Add($"Failed to delete Asset", Severity.Error);
            }
        }
    }

    private async Task OpenEdit()
    {
        Navigation.NavigateTo($"/assets/edit/{asset.Id.ToString()}");
    }
}