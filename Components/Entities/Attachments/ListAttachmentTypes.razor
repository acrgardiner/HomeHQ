@page "/attachmenttypes"
@using projectaardvarkx2.Entities
@using projectaardvarkx2.Services
@using projectaardvarkx2.Components.Entities.Common

@inject IEntityService<AttachmentType> AttachmentTypeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ListAttachmentTypes> Logger

<MudContainer MaxWidth="@MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Attachment Types</MudText>
    <MudPaper Class="p-4">
        <EntityList TEntityType="AttachmentType" Plural="Attachment Types" Singular="Attachment Type" EntityService="AttachmentTypeService"
                    CreateDialog="@( () => DialogService.ShowAsync<CreateAttachmentType>("Add New Attachment Type") )"
                    EditDialog="@(parameters => DialogService.ShowAsync<EditAttachmentType>("Edit Attachment Type", parameters))"
            Logger="Logger"
            Columns="@(
                new List<(Func<AttachmentType, object?>, string)>
                {
                    (new Func<AttachmentType, object?>(x => x.Name), "Name"),
                })"
            >
        </EntityList>
    </MudPaper>
</MudContainer>
