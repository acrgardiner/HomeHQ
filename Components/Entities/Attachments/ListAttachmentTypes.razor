@page "/attachmenttypes"

@using projectaardvarkx2.Entities
@using projectaardvarkx2.Services
@using projectaardvarkx2.Components.Entities.Common
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<AttachmentType> AttachmentTypeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ListAttachmentTypes> Logger

<PageTitle>Attachment Types- Home Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <!-- Header and actions -->
    <div class="d-flex align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-3" Size="Size.Large" />
                Attachment Types
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Configure Attachment Types
            </MudText>
        </div>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @* <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Upload"
                       OnClick="@(() => { /* TODO: Import functionality */ })"
                       Class="entity-action-btn">
                Import
            </MudButton> *@

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate"
                       Class="entity-action-btn">
                New Category
            </MudButton>
        </MudStack>
    </div>

    <!-- Main Content Card -->
    <MudCard Elevation="2" Class="entity-list-card">
        <EntityList TEntityType="AttachmentType" Plural="Attachment Types" Singular="Attachment Type" EntityService="AttachmentTypeService"
                    EditDialog="@(parameters => DialogService.ShowAsync<EditAttachmentType>("Edit Attachment Type", parameters))"
            Logger="Logger"
            Columns="@(
                new List<(Func<AttachmentType, object?>, string)>
                {
                    (new Func<AttachmentType, object?>(x => x.Name), "Name"),
                })"
            >
        </EntityList>
    </MudCard>
</MudContainer>

@code {
    private async Task OpenCreate()
    {
        await DialogService.ShowAsync<CreateAttachmentType>("Add New Attachment Type");
    }
}