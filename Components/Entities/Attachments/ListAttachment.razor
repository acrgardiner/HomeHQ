@page "/attachments"

@using HomeHQ.Entities
@using HomeHQ.Services
@using System.Linq.Expressions
@using HomeHQ.Components.Entities.Common
@using HomeHQ.Helpers
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<Attachment> AttachmentService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ListAttachment> Logger

<MudContainer MaxWidth="@MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Attachments</MudText>
    <MudPaper Class="p-4">
        <EntityList TEntityType="Attachment" Plural="Attachments" Singular="Attachment" EntityService="AttachmentService"
            Logger="Logger"
            Includes="@(Includes)"
            Columns="@(
                    new List<(Func<Attachment, object?>, string)>{
                        ((Func<Attachment, object?>)(x => (RenderFragment)(builder =>
                            {
                                if (x.ParentId.HasValue)
                                {
                                    builder.OpenElement(0, "a");
                                    builder.AddAttribute(1, "href", $"/assets/{x.ParentId}");
                                    builder.AddContent(2, x.ParentId.ToString());
                                    builder.CloseElement();
                                }
                            })), "Parent"),
                        (new Func<Attachment, object?>(x => x.OriginFileName), "Origin File Name"),
                        (new Func<Attachment, object?>(x => x.LocalFileName), "Local File Name"),
                        (new Func<Attachment, object?>(x => x.Extension), "Extension"),
                        (new Func<Attachment, object?>(x => x.AttachmentType?.Name), "Attachment Type"),
                        (new Func<Attachment, object?>(x => $"{Formatter.FormatFileSize(x.FileSize)}"), "File Size")
                    }
                )"
            ItemActions="AttachmentActions"
            EnableItemDelete="true">
        </EntityList>
    </MudPaper>
</MudContainer>
@code {
    private List<EntityAction<Attachment>> AttachmentActions => new()
    {
        new EntityAction<Attachment>
        {
            Icon = Icons.Material.Filled.Image,
            Tooltip = "View",
            Action = async (attachment) => await ShowGalleryAsync(attachment)
        }
    };

    private Task ShowGalleryAsync(Attachment attachment)
    {
        var param = new DialogParameters<ViewImage>()
        {
            { x => x.Attachment, attachment }
        };
        return DialogService.ShowAsync<ViewImage>("View Attachment", param);
    }

    List<Expression<Func<Attachment, object>>>? Includes => new List<Expression<Func<Attachment, object>>>
    {
        x => x.AttachmentType
    };
}


