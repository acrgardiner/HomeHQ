@page "/warrantytypes"
@using projectaardvarkx2.Entities
@using projectaardvarkx2.Services
@using projectaardvarkx2.Components.Entities.Common

@inject IEntityService<WarrantyType> WarrantyTypeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ListWarrantyTypes> Logger

<MudContainer MaxWidth="@MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Warranty Types</MudText>
    <MudPaper Class="p-4">
        <EntityList TEntityType="WarrantyType" Plural="Warranty Types" Singular="Warranty Type" EntityService="WarrantyTypeService"
            CreateDialog="@( () => DialogService.ShowAsync<CreateWarrantyType>("Add New Warranty Type") )"
            EditDialog="@(parameters => DialogService.ShowAsync<EditWarrantyType>("Edit Warranty Type", parameters))"
            Logger="Logger"
            Columns="@(
                new List<(Func<WarrantyType, object?>, string)>
                {
                    (x => x.Name, "Name"),
                    (x => $"{x.Years ?? 0} Years {x.Months ?? 0} Months {x.Days ?? 0} Days", "Length")
                }
            )"
        >
        </EntityList>
    </MudPaper>
</MudContainer>