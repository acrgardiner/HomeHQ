@page "/warrantytypes"

@using HomeHQ.Entities
@using HomeHQ.Services
@using HomeHQ.Components.Entities.Common
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<WarrantyType> WarrantyTypeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ListWarrantyTypes> Logger

<PageTitle>Warranty Types - @Constants.Application.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <!-- Header and actions -->
    <div class="d-flex align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Verified" Class="mr-3" Size="Size.Large" />
                Warranty Types
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Configure Warranty Types
            </MudText>
        </div>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @* <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Upload"
                       OnClick="@(() => { /* TODO: Import functionality */ })"
                       Class="entity-action-btn">
                Import
            </MudButton> *@

            <MudFab Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenCreate"
                Size="Size.Small">
            </MudFab>
        </MudStack>
    </div>

    <!-- Main Content Card -->
    <MudCard Elevation="2" Class="entity-list-card">
        <EntityList @ref="@entityList" TEntityType="WarrantyType" Plural="Warranty Types" Singular="Warranty Type" EntityService="WarrantyTypeService"
            EditDialog="@(parameters => DialogService.ShowAsync<EditWarrantyType>("Edit Warranty Type", parameters))"
            Logger="Logger"
            Columns="@(
                new List<(Func<WarrantyType, object?>, string)>
                {
                    (x => x.Name, "Name"),
                    (x => $"{x.Years ?? 0} Years {x.Months ?? 0} Months {x.Days ?? 0} Days", "Length")
                }
            )"
        >
        </EntityList>
    </MudCard>
</MudContainer>

@code {
    private EntityList<WarrantyType>? entityList;

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
    }

    protected override async Task OnParametersSetAsync()
    {
        await entityList?.ReloadData();
    }

    private async Task OpenCreate()
    {
        await DialogService.ShowAsync<CreateWarrantyType>("Add New Warranty Type");
    }
}