@using System.ComponentModel.DataAnnotations
@using projectaardvarkx2.Identity
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin")]

@inject IUserService UserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<EditForm Model="@newUser" OnValidSubmit="Submit">
<DataAnnotationsValidator/>
    <MudDialog Options="_dialogOptions">
        <DialogContent>
            <MudTextField Label="Username" HelperText="Max. 8 characters" @bind-Value="newUser.UserName" For="@(() => newUser.UserName)" />
            <MudTextField @bind-Value="newUser.Password"
                For="@(() => newUser.Password)"
                Label="Password"
                InputType="@_passwordInput"
                Adornment="Adornment.End"
                AdornmentIcon="@_passwordInputIcon"
                OnAdornmentClick="TogglePasswordVisibility"
                AdornmentAriaLabel="Show Password"
                Variant="Variant.Outlined"
                Margin="Margin.Dense"
                HelperText="Choose a strong password"
                Class="mt-3"
            />
            @*<MudTextField Label="Password" HelperText="Repeat the password" Class="mt-3"*@
            <MudTextField @bind-Value="newUser.ConfirmPassword"
                          For="@(() => newUser.ConfirmPassword)"
                Label="Password"
                InputType="@_confirmPasswordInput"
                Adornment="Adornment.End"
                AdornmentIcon="@_confirmPasswordInputIcon"
                OnAdornmentClick="ToggleConfirmPasswordVisibility"
                AdornmentAriaLabel="Show Password"
                Variant="Variant.Outlined"
                Margin="Margin.Dense"
                HelperText="Repeat the password"
                Class="mt-3"
            />
            <MudCheckBox T="bool" @bind-Value="newUser.IsAdmin" Label="Admin User" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">Create</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>


@code {
    [Inject] private ILogger<CreateUser> _logger { get; set; }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    private readonly DialogOptions _dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };

    private MudForm form;
    private NewUserForm newUser = new();

    // Password visibility toggles
    private bool _passwordVisible = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private bool _confirmPasswordVisible = false;
    private InputType _confirmPasswordInput = InputType.Password;
    private string _confirmPasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    bool success;
    string[] errors = { };

    protected override async Task OnInitializedAsync()
    {
        await MudDialog.SetOptionsAsync(_dialogOptions);
    }

    private class NewUserForm
    {
        [Required]
        public string UserName { get; set; }

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; }

        [Required]
        [Compare(nameof(Password))]
        public string ConfirmPassword { get; set; }

        public bool IsAdmin { get; set; } = false;

        public NewUserForm()
        {
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        try
        {
            List<Roles> userRoles = new() { Roles.Basic };

            if (newUser.IsAdmin)
            {
                userRoles.Add(Roles.Admin);
            };

            await UserService.AddUser(newUser.UserName, newUser.Password, userRoles);
            Snackbar.Add("User created successfully", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error creating user");
            Snackbar.Add("Error creating user", Severity.Error);
        }
    }

    private void TogglePasswordVisibility()
    {
        if (_passwordVisible)
        {
            _passwordVisible = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _passwordVisible = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }

    private void ToggleConfirmPasswordVisibility()
    {
        if (_confirmPasswordVisible)
        {
            _confirmPasswordVisible = false;
            _confirmPasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            _confirmPasswordInput = InputType.Password;
        }
        else
        {
            _confirmPasswordVisible = true;
            _confirmPasswordInputIcon = Icons.Material.Filled.Visibility;
            _confirmPasswordInput = InputType.Text;
        }
    }
}