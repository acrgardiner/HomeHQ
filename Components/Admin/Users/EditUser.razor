@using projectaardvarkx2.Identity
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations

@inject IUserService UserService
@inject ISnackbar Snackbar

@attribute [Authorize(Roles = "Admin")]

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit User</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="@model">
            <MudTextField T="string" @bind-Value="model.UserName" Label="Username" Required="true"
            RequiredError="Name is required!" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ILogger<EditUser> _logger { get; set; }
    [CascadingParameter] IMudDialogInstance Dialog { get; set; }

    [Parameter] public ApplicationUser User { get; set; }
    [Parameter] public string Title { get; set; }


    private MudForm form;
    private EditUserForm model = new();

    protected override void OnInitialized()
    {
        model.UserName = User.UserName;
    }

    private class EditUserForm
    {
        [Required]
        [StringLength(256, MinimumLength = 3, ErrorMessage = "Username must be between 3 and 256 characters.")]
        public string? UserName { get; set; }
    }

    private void Cancel() => Dialog.Cancel();

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                if (await UserService.UpdateUserName(User.Id, model.UserName))
                    Snackbar.Add("User updated successfully", Severity.Success);
                else
                    Snackbar.Add("User update failed", Severity.Error);
                Dialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error updating user");
                Snackbar.Add("Error updating user", Severity.Error);
            }
        }
    }
}