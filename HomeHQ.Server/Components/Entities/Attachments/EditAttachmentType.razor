@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<AttachmentType> AttachmentService
@inject ISnackbar Snackbar
@inject ILogger<EditAttachmentType> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Attachment Type</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model">
            <MudTextField T="string" @bind-Value="_model.Name" Label="Name" Required="true" RequiredError="Name is required!" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog>

