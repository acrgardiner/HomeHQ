@page "/attachments"

@using HomeHQ.Components.Entities.Common
@using HomeHQ.Entities
@using HomeHQ.Services
@using System.Linq.Expressions
@using HomeHQ.Server.Components.Entities.Common
@using HomeHQ.Helpers
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<Attachment> AttachmentService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ListAttachment> Logger

<MudContainer MaxWidth="@MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Attachments</MudText>
    <MudPaper Class="p-4">
        <EntityList TEntityType="Attachment" Plural="Attachments" Singular="Attachment" EntityService="AttachmentService"
            Logger="Logger"
            Includes="@(Includes)"
            Columns="@(
                    new List<(System.Linq.Expressions.Expression<Func<Attachment, object>>, string)>{
                        ((System.Linq.Expressions.Expression<Func<Attachment, object>>)(x => x.ParentId), "Parent"),
                        ((System.Linq.Expressions.Expression<Func<Attachment, object>>)(x => x.OriginFileName), "Origin File Name"),
                        ((System.Linq.Expressions.Expression<Func<Attachment, object>>)(x => x.LocalFileName), "Local File Name"),
                        ((System.Linq.Expressions.Expression<Func<Attachment, object>>)(x => x.Extension), "Extension"),
                        ((System.Linq.Expressions.Expression<Func<Attachment, object>>)(x => x.AttachmentType != null ? x.AttachmentType.Name : null), "Attachment Type"),
                        ((System.Linq.Expressions.Expression<Func<Attachment, object>>)(x => $"{Formatter.FormatFileSize(x.FileSize)}"), "File Size")
                    }
                )"
            ItemActions="AttachmentActions"
            EnableItemDelete="true">
        </EntityList>
    </MudPaper>
</MudContainer>



