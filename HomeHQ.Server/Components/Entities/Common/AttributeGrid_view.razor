@using Microsoft.AspNetCore.Authorization
@using HomeHQ.Identity
@using HomeHQ.Services
@using HomeHQ.Entities
@using HomeHQ.Helpers
@using System.Linq.Expressions

@attribute [Authorize()]

@inject ISnackbar Snackbar
@inject IEntityService<AttributeValue> AttributeService
@inject IDialogService DialogService
@inject ILogger<AttributeList_view> Logger

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6" Gutters="false">
    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">Attributes</MudText>
    <MudPaper Class="p-4">
        <MudDataGrid T="AttributeValue" Items="@_attributes"
        Hideable="true" Hover="true" Dense="true"
        Striped="false" Bordered="false" ReadOnly="true" Class="elevation-1" Loading="_loading">
            <Columns>
                <PropertyColumn Property="x => x.Attribute" />
                <PropertyColumn Property="x => x.Value" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="AttributeValue" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>


