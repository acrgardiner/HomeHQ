@using Microsoft.AspNetCore.Authorization
@using HomeHQ.Identity
@using HomeHQ.Services
@using HomeHQ.Entities
@using HomeHQ.Helpers
@using System.Linq.Expressions

@attribute [Authorize()]

@inject ISnackbar Snackbar
@inject IEntityService<HomeHQ.Entities.Attribute> AttributeService
@inject IDialogService DialogService
@inject ILogger<AttributeList_view> Logger

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6" Gutters="false">
    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">Attributes</MudText>
    @if (_attributes.Any())
    {
        foreach (var attr in _attributes)
        {
            <MudStack Row="true" Spacing="2" Class="mb-2">
                <MudTextField @bind-Value="attr.Key" Label="Key" Required="true" ReadOnly=true/>
                <MudTextField @bind-Value="attr.Value" Label="Value" Required="true" ReadOnly=true  />
            </MudStack>
        }
    }
</MudContainer>


