@using Microsoft.AspNetCore.Authorization
@using HomeHQ.Identity
@using HomeHQ.Services
@using HomeHQ.Entities
@using HomeHQ.Helpers
@using System.Linq.Expressions

@attribute [Authorize()]

@inject ISnackbar Snackbar
@inject IEntityService<Attachment> AttachmentService
@inject IDialogService DialogService
@inject ILogger<AttachmentList_view> Logger

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6" Gutters="false">
    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">Attachments</MudText>
    <MudPaper Class="p-4">
        <MudDataGrid T="Attachment" Items="@_attachments"
        Hideable="true" Hover="true" Dense="true"
        Striped="false" Bordered="false" ReadOnly="true" Class="elevation-1" Loading="_loading">
            <Columns>
                <PropertyColumn Property="x => x.Extension" />
                <PropertyColumn Property="x => Formatter.FormatFileSize(x.FileSize)" />
                <PropertyColumn Property="x => x.AttachmentType.Name" />
                <TemplateColumn T="Attachment" Title="Actions">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0" Class="pa-2">
                            <div>
                                <MudIconButton Icon="@Icons.Material.Filled.Image" Color="Color.Primary" Size="Size.Small" Class="mx-1"
                                OnClick="@(() => ShowGalleryAsync(context.Item))" />
                            </div>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Attachment" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>


