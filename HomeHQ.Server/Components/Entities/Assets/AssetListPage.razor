@page "/assets"
@using System.Linq.Expressions
@using HomeHQ.Components.Entities.Common
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@using System.Text
@using HomeHQ.Server

@attribute [Authorize()]

@inject IEntityService<Asset> AssetService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<AssetListPage> Logger
@inject NavigationManager NavigationManager

<PageTitle>Assets - @Constants.Application.TITLE</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <!-- Header and actions -->
    <div class="d-flex align-center mb-6">
        <div class="flex-grow-1">
            <MudText Typo="Typo.h4" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mr-3" Size="Size.Large" />
                Assets Management
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Manage your assets, track warranties, and organize documentation
            </MudText>
        </div>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudFab Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenCreate"
                Size="Size.Small">
            </MudFab>
        </MudStack>
    </div>

    <!-- Statistics Cards -->
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="6" sm="4">
            <MudCard Elevation="2" Class="dashboard-card">
                <MudCardContent Class="pb-0">
                    <div class="d-flex justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Total Assets</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Primary">@_totalAssets</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Class="dashboard-avatar">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                        </MudAvatar>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="6" sm="4">
            <MudCard Elevation="2" Class="dashboard-card">
                <MudCardContent Class="pb-0">
                    <div class="d-flex justify-space-between">
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Warranties Expiring</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Warning">@_warrantiesExpiring</MudText>
                        </div>
                        <MudAvatar Color="Color.Warning" Class="dashboard-avatar">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" />
                        </MudAvatar>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Main Content Card -->
    <MudCard Elevation="2" Class="assets-list-card">
        <EntityList @ref="@_entityList" TEntityType="Asset"
                    Plural="Assets"
                    Singular="Asset"
                    EntityService="AssetService"
                    Logger="Logger"
                    Includes="@(Includes)"
                    Columns="@(
                        new List<(Func<Asset, object?>, string)>{
                            (new Func<Asset, object?>(x => x.Name), "Name"),
                            (new Func<Asset, object?>(x => x.Category?.Title ?? "Uncategorized"), "Category"),
                            (new Func<Asset, object?>(x => x.PurchasedFrom), "From"),
                            (new Func<Asset, object?>(x => Formatter.FormatDate(x.PurchaseDate, "MMM dd, yyyy")), "Purchase Date"),
                            (new Func<Asset, object?>(x => WarrantyFormatter.RenderWarrantyInfo(x)), "Warranty"),
                        }
                    )"
                    ItemActions="_AssetActions"
                    EnableItemDelete="false"
                    EnableExport="true"
                    OnRowClicked="@(RowClicked)">
            <ToolbarActions>
                <!-- Additional toolbar actions can go here -->
            </ToolbarActions>
        </EntityList>
    </MudCard>
</MudContainer>




