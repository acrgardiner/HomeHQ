@using HomeHQ.Identity
@using HomeHQ.Entities
@using HomeHQ.Services
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<WarrantyType> WarrantyService
@inject ISnackbar Snackbar
@inject ILogger<EditWarrantyType> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Warranty Type</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model">
            <MudTextField T="string" @bind-Value="_model.Name" Label="Name" Required="true" RequiredError="Name is required!" />
            <MudDivider />
            <MudNumericField T="int?" @bind-Value="_model.Years" Label="Years" />
            <MudNumericField T="int?" @bind-Value="_model.Months" Label="Months" />
            <MudNumericField T="int?" @bind-Value="_model.Days" Label="Days" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog>

