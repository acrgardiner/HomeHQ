@page "/categories"

@using HomeHQ.Entities
@using HomeHQ.Services
@using HomeHQ.Server.Components.Entities.Common
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<Category> CategoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ListCategories> Logger

<PageTitle>Categories - @Constants.Application.TITLE</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <!-- Header and actions -->
    <div class="d-flex align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-3" Size="Size.Large" />
                Categories
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Configure Categories
            </MudText>
        </div>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @* <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Upload"
                       OnClick="@(() => { /* TODO: Import functionality */ })"
                       Class="entity-action-btn">
                Import
            </MudButton> *@
            <MudFab Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.Add"
                    OnClick="OpenCreate"
                    Size="Size.Small">
            </MudFab>
        </MudStack>
    </div>

    <!-- Main Content Card -->
    <MudCard Elevation="2" Class="entity-list-card">
        <EntityList @ref="@_entityList" TEntityType="Category" Plural="Categories" Singular="Category" EntityService="CategoryService"
            EditDialog="@(parameters => DialogService.ShowAsync<EditCategory>("Edit Category", parameters))"
            Logger="Logger"
            Columns="@(
                new List<(Func<Category, object?>, string)>
                {
                    (x => x.Icon, "Icon"),
                    (x => x.Name, "Name")
                })">
        </EntityList>
    </MudCard>
</MudContainer>

