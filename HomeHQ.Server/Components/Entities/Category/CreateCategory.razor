@using HomeHQ.Identity
@using HomeHQ.Services;
@using HomeHQ.Entities;
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize()]

@inject IEntityService<Category> CategoryService;
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<CreateCategory> Logger

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model">
            <MudTextField T="string" @bind-Value="_model.Name" Label="Name" Required="true" RequiredError="Name is required!" />
            <MudTextField T="string" @bind-Value="_model.Icon" Label="Icon" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

