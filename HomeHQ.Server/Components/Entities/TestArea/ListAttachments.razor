@page "/test/attachments"
@using Microsoft.AspNetCore.Authorization
@using HomeHQ.Identity
@using HomeHQ.Services
@using HomeHQ.Entities


@inject IEntityService<Attachment> AttachmentService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ListAttachments> Logger

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Attachments</MudText>
    <MudPaper Class="p-4">
        <MudDataGrid T="Attachment" Items="@_attachments" Loading="@_loading" QuickFilter="@_quickFilter"
        Hideable="true" Hover="true" Dense="true"
        Striped="false" Bordered="false" ReadOnly="true" Class="elevation-1">
            <ToolBarContent>
                <MudTextField @bind-Value="SearchString" Placeholder="Search..." Adornment="Adornment.Start"
                Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mx-2" />
                <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                Size="Size.Medium" OnClick="ReloadData" Class="mx-1" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Id" />
                <PropertyColumn Property="x => x.OriginFileName" />
                <PropertyColumn Property="x => x.Extension" />
                <PropertyColumn Property="x => x.FileSize" />
                <PropertyColumn Property="x => x.AttachmentTypeId" />
                <PropertyColumn Property="x => x.AttachmentType.Id" />
                <PropertyColumn Property="x => x.AttachmentType.Name" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Attachment" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>


