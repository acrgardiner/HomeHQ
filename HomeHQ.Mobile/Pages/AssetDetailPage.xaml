<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HomeHQ.Mobile.ViewModels"
             xmlns:entities="clr-namespace:HomeHQ.Entities;assembly=HomeHQ.Shared"
             x:Class="HomeHQ.Mobile.Pages.AssetDetailPage"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="vm:AssetDetailViewModel"
             Title="{Binding Asset.Name, FallbackValue='Asset Details'}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Card Style -->
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            
            <!-- Section Header Style -->
            <Style x:Key="SectionHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            </Style>
            
            <!-- Field Label Style -->
            <Style x:Key="FieldLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource Gray500}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            
            <!-- Field Value Style -->
            <Style x:Key="FieldValueStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Custom Header -->
        <Grid Grid.Row="0" 
              Padding="8,8,8,8"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
              ColumnDefinitions="Auto, *, Auto, Auto">

            <!-- Back Button -->
            <Button Grid.Column="0"
                x:Name="BackButton"
                mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ArrowBack}"
                Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent"
                WidthRequest="44"
                HeightRequest="44"
            />

            <!-- Title -->
            <VerticalStackLayout Grid.Column="1" 
                                 VerticalOptions="Center"
                                 Padding="8,0">
                <Label Text="{Binding Asset.Name, FallbackValue='Asset Details'}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       LineBreakMode="TailTruncation"/>
            </VerticalStackLayout>
            
            <!-- Edit Button -->
            <Button Grid.Column="2"
                x:Name="EditAsset"
                mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Edit}"
                Command="{Binding EditCommand}"
                BackgroundColor="{StaticResource Primary}"
                CornerRadius="20"
                WidthRequest="40"
                HeightRequest="40"
                Margin="4,0"
            />

            <!-- Delete Button -->
            <Button Grid.Column="3"
                mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Delete}"
                x:Name="DeleteAsset"
                Command="{Binding DeleteCommand}"
                BackgroundColor="{StaticResource Error}"
                CornerRadius="20"
                WidthRequest="40"
                HeightRequest="40"
                Margin="4,0"/> 
        </Grid>
        
        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               HeightRequest="48"
                               WidthRequest="48"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>

            <!-- Error State -->
            <VerticalStackLayout IsVisible="{Binding HasError}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="16"
                                 Padding="32">
                <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Warning}" FontSize="64" HorizontalOptions="Center"/>
                <Label Text="Something went wrong"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray600}"
                       HorizontalOptions="Center"/>
                <Label Text="{Binding ErrorMessage}"
                       FontSize="14"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Try Again"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="44"
                        WidthRequest="120"/>
            </VerticalStackLayout>

            <!-- Main Content -->
            <ScrollView IsVisible="{Binding ShowContent}">
                <VerticalStackLayout Padding="16" Spacing="0">
                    
                    <!-- Basic Information Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <!-- Card Header -->
                            <Grid Padding="16,12" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                  ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" 
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Info}"
                                       FontSize="20" 
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <Label Grid.Column="1"
                                       Text="Basic Information" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>
                            </Grid>
                            
                            <BoxView HeightRequest="1" 
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>
                            
                            <!-- Card Content -->
                            <Grid Padding="16,16,16,0" 
                                  RowDefinitions="Auto, Auto, Auto, Auto"
                                  ColumnDefinitions="*, *"
                                  RowSpacing="16"
                                  ColumnSpacing="16">
                                
                                <!-- Name -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding Asset.Name}" Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                                
                                <!-- Category -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                    <Label Text="Category" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding CategoryTitle}" Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                                
                                <!-- Purchased From -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                    <Label Text="Purchased From" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding Asset.PurchasedFrom, TargetNullValue='Not specified'}" 
                                           Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                                
                                <!-- Purchase Date -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                    <Label Text="Purchase Date" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding PurchaseDateFormatted}" Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Warranty Information Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <!-- Card Header -->
                            <Grid Padding="16,12" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                  ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" 
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Verified}"
                                       FontSize="20" 
                                       TextColor="{Binding WarrantyStatusColor}"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <Label Grid.Column="1" 
                                       Text="Warranty Information" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>
                            </Grid>
                            
                            <BoxView HeightRequest="1" 
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>
                            
                            <!-- Card Content -->
                            <Grid Padding="16" 
                                  RowDefinitions="Auto"
                                  ColumnDefinitions="*, *"
                                  ColumnSpacing="16">
                                
                                <!-- Warranty Type -->
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Warranty Type" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding Asset.WarrantyType.Name, TargetNullValue='No warranty'}" 
                                           Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                                
                                <!-- Warranty Expiration -->
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Warranty Expiration" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding WarrantyExpirationFormatted}" 
                                           Style="{StaticResource FieldValueStyle}"/>
                                    <Label Text="{Binding WarrantyStatusText}" 
                                           FontSize="12"
                                           TextColor="{Binding WarrantyStatusColor}"
                                           IsVisible="{Binding HasWarranty}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Attributes Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <!-- Card Header -->
                            <Grid Padding="16,12" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                  ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" 
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Extension}"
                                       TextColor="{StaticResource Info}"
                                       FontSize="20" 
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <Label Grid.Column="1" 
                                       Text="Attributes" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>
                            </Grid>
                            
                            <BoxView HeightRequest="1" 
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>
                            
                            <!-- Attributes List -->
                            <VerticalStackLayout Padding="16" IsVisible="{Binding HasAttributes}">
                                <CollectionView ItemsSource="{Binding Attributes}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AttributeValue">
                                            <Grid ColumnDefinitions="*, *" 
                                                  Padding="0,8"
                                                  ColumnSpacing="16">
                                                <Label Grid.Column="0" 
                                                       Text="{Binding Attribute}" 
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
                                                <Label Grid.Column="1" 
                                                       Text="{Binding Value}" 
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                            
                            <!-- Empty State -->
                            <VerticalStackLayout Padding="24" 
                                                 IsVisible="{Binding HasAttributes, Converter={StaticResource InvertedBoolConverter}}"
                                                 HorizontalOptions="Center">
                                <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ExtensionOff}" FontSize="32" HorizontalOptions="Center" Opacity="0.5"/>
                                <Label Text="No attributes" 
                                       FontSize="14" 
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Notes Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <!-- Card Header -->
                            <Grid Padding="16,12" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                  ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" 
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Notes}"
                                       FontSize="20" 
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <Label Grid.Column="1" 
                                       Text="Notes" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>
                            </Grid>
                            
                            <BoxView HeightRequest="1" 
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>
                            
                            <!-- Notes List -->
                            <VerticalStackLayout Padding="16" IsVisible="{Binding HasNotes}">
                                <CollectionView ItemsSource="{Binding Notes}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Note">
                                            <Frame Padding="12" 
                                                   Margin="0,0,0,8"
                                                   CornerRadius="8"
                                                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                                   HasShadow="False">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding Title}" 
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                                    <Label Text="{Binding Content}" 
                                                           FontSize="13"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                            
                            <!-- Empty State -->
                            <VerticalStackLayout Padding="24" 
                                                 IsVisible="{Binding HasNotes, Converter={StaticResource InvertedBoolConverter}}"
                                                 HorizontalOptions="Center">
                                <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ExtensionOff}" FontSize="32" HorizontalOptions="Center" Opacity="0.5"/>
                                <Label Text="No notes" 
                                       FontSize="14" 
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Attachments Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <!-- Card Header -->
                            <Grid Padding="16,12" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                  ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" 
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=AttachFile}"
                                       FontSize="20" 
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0" TextColor="{StaticResource Warning}"/>
                                <Label Grid.Column="1" 
                                       Text="Attachments" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" 
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>

                            <!-- Attachments List -->
                            <VerticalStackLayout Padding="16" IsVisible="{Binding HasAttachments}">
                                <CollectionView ItemsSource="{Binding Attachments}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Attachment">
                                            <Frame Padding="12" 
                                                   Margin="0,0,0,8"
                                                   CornerRadius="8"
                                                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                                   HasShadow="False">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AssetDetailViewModel}}, Path=OpenAttachmentCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Frame.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                                    
                                                    <!-- File Icon -->
                                                    <Frame Grid.Column="0"
                                                           BackgroundColor="{StaticResource Primary}"
                                                           CornerRadius="8"
                                                           Padding="8"
                                                           HasShadow="False"
                                                           HeightRequest="40"
                                                           WidthRequest="40">
                                                        <Label Text="📄"
                                                               FontSize="16"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>
                                                    </Frame>

                                                    <!-- File Info -->
                                                    <VerticalStackLayout Grid.Column="1" 
                                                                         VerticalOptions="Center"
                                                                         Spacing="2">
                                                        <Label Text="{Binding OriginFileName}" 
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                               LineBreakMode="TailTruncation"/>
                                                        <Label Text="{Binding ContentType}" 
                                                               FontSize="12"
                                                               TextColor="{StaticResource Gray500}"/>
                                                    </VerticalStackLayout>

                                                    <!-- Open Indicator -->
                                                    <Label Grid.Column="2"
                                                           Text="›"
                                                           FontSize="24"
                                                           TextColor="{StaticResource Gray400}"
                                                           VerticalOptions="Center"/>
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <!-- Empty State -->
                            <VerticalStackLayout Padding="24" 
                                                 IsVisible="{Binding HasAttachments, Converter={StaticResource InvertedBoolConverter}}"
                                                 HorizontalOptions="Center">
                                <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ExtensionOff}" FontSize="32" HorizontalOptions="Center" Opacity="0.5"/>
                                <Label Text="No attachments" 
                                       FontSize="14" 
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
