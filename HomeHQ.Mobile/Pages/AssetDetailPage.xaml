<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HomeHQ.Mobile.ViewModels"
             xmlns:entities="clr-namespace:HomeHQ.Entities;assembly=HomeHQ.Domain"
             x:Class="HomeHQ.Mobile.Pages.AssetDetailPage"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="vm:AssetDetailViewModel"
             Title="{Binding Asset.Name, FallbackValue='Asset Details'}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Card Style -->
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            
            <!-- Section Header Style -->
            <Style x:Key="SectionHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            </Style>
            
            <!-- Field Label Style -->
            <Style x:Key="FieldLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource Gray500}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            
            <!-- Field Value Style -->
            <Style x:Key="FieldValueStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Custom Header -->
        <Grid Grid.Row="0" 
              Padding="8,8,8,8"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
              ColumnDefinitions="Auto, *, Auto, Auto">

            <!-- Back Button -->
            <Button Grid.Column="0"
                x:Name="BackButton"
                mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ArrowBack}"
                Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent"
                WidthRequest="44"
                HeightRequest="44"
            />

            <!-- Title -->
            <VerticalStackLayout Grid.Column="1" 
                                 VerticalOptions="Center"
                                 Padding="8,0">
                <Label Text="{Binding Asset.Name, FallbackValue='Asset Details'}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       LineBreakMode="TailTruncation"/>
            </VerticalStackLayout>
            
            <!-- Edit Button -->
            <Button Grid.Column="2"
                x:Name="EditAsset"
                mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Edit}"
                Command="{Binding EditCommand}"
                BackgroundColor="{StaticResource Primary}"
                CornerRadius="20"
                WidthRequest="40"
                HeightRequest="40"
                Margin="4,0"
            />

            <!-- Delete Button -->
            <Button Grid.Column="3"
                mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Delete}"
                x:Name="DeleteAsset"
                Command="{Binding DeleteCommand}"
                BackgroundColor="{StaticResource Error}"
                CornerRadius="20"
                WidthRequest="40"
                HeightRequest="40"
                Margin="4,0"/> 
        </Grid>
        
        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               HeightRequest="48"
                               WidthRequest="48"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>

            <!-- Error State -->
            <VerticalStackLayout IsVisible="{Binding HasError}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="16"
                                 Padding="32">
                <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Warning}" FontSize="64" HorizontalOptions="Center"/>
                <Label Text="Something went wrong"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray600}"
                       HorizontalOptions="Center"/>
                <Label Text="{Binding ErrorMessage}"
                       FontSize="14"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Try Again"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="44"
                        WidthRequest="120"/>
            </VerticalStackLayout>

            <!-- Main Content -->
            <ScrollView IsVisible="{Binding ShowContent}">
                <VerticalStackLayout Padding="16" Spacing="0">
                    
                    <!-- Basic Information Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <!-- Card Header -->
                            <Grid Padding="16,12" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                  ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" 
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Info}"
                                       TextColor="{StaticResource Primary}"
                                       FontSize="20" 
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <Label Grid.Column="1"
                                       Text="Basic Information" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>
                            </Grid>
                            
                            <BoxView HeightRequest="1" 
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                            
                            <!-- Card Content -->
                            <Grid Padding="16,16,16,0" 
                                  RowDefinitions="Auto, Auto, Auto, Auto"
                                  ColumnDefinitions="*, *"
                                  RowSpacing="16"
                                  ColumnSpacing="16">
                                
                                <!-- Name -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding Asset.Name}" Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                                
                                <!-- Category -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                    <Label Text="Category" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding Asset.Category.Title}" Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                                
                                <!-- Purchased From -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                    <Label Text="Purchased From" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding Asset.PurchasedFrom, TargetNullValue='Not specified'}" 
                                           Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                                
                                <!-- Purchase Date -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                    <Label Text="Purchase Date" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding PurchaseDateFormatted}" Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Warranty Information Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <!-- Card Header -->
                            <Grid Padding="16,12" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                  ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" 
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Verified}"
                                       FontSize="20"
                                       TextColor="{StaticResource Success}"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <Label Grid.Column="1" 
                                       Text="Warranty Information" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>
                            </Grid>
                            
                            <BoxView HeightRequest="1" 
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                            
                            <!-- Card Content -->
                            <Grid Padding="16" 
                                  RowDefinitions="Auto"
                                  ColumnDefinitions="*, *"
                                  ColumnSpacing="16">
                                
                                <!-- Warranty Type -->
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Warranty Type" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding Asset.WarrantyType.Name, TargetNullValue='No warranty'}" 
                                           Style="{StaticResource FieldValueStyle}"/>
                                </VerticalStackLayout>
                                
                                <!-- Warranty Expiration -->
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Warranty Expiration" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding WarrantyExpirationFormatted}" 
                                           Style="{StaticResource FieldValueStyle}"/>
                                    <Label Text="{Binding WarrantyStatusText}" 
                                           FontSize="12"
                                           TextColor="{Binding WarrantyStatusColor}"
                                           IsVisible="{Binding HasWarranty}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Attributes Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <!-- Card Header -->
                            <Grid Padding="16,12" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                  ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" 
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Extension}"
                                       TextColor="{StaticResource Info}"
                                       FontSize="20" 
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <Label Grid.Column="1" 
                                       Text="Attributes" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>
                            </Grid>
                            
                            <BoxView HeightRequest="1" 
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                            
                            <!-- Attributes List -->
                            <VerticalStackLayout Padding="16" IsVisible="{Binding HasAttributes}">
                                <CollectionView ItemsSource="{Binding Attributes}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Attribute">
                                            <Grid ColumnDefinitions="*, *" 
                                                  Padding="0,8"
                                                  ColumnSpacing="16">
                                                <Label Grid.Column="0" 
                                                       Text="{Binding Key}" 
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                                <Label Grid.Column="1" 
                                                       Text="{Binding Value}" 
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                            
                            <!-- Empty State -->
                            <VerticalStackLayout Padding="24" 
                                                 IsVisible="{Binding HasAttributes, Converter={StaticResource InvertedBoolConverter}}"
                                                 HorizontalOptions="Center">
                                <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ExtensionOff}" FontSize="32" HorizontalOptions="Center" Opacity="0.5"/>
                                <Label Text="No attributes" 
                                       FontSize="14" 
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Notes Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <!-- Card Header -->
                            <Grid Padding="16,12" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                  ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" 
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Notes}"
                                       FontSize="20"
                                       TextColor="{StaticResource Warning}"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <Label Grid.Column="1" 
                                       Text="Notes" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>
                            </Grid>
                            
                            <BoxView HeightRequest="1" 
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                            
                            <!-- Notes List -->
                            <VerticalStackLayout Padding="16" IsVisible="{Binding HasNotes}">
                                <CollectionView ItemsSource="{Binding Notes}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Note">
                                            <Frame Padding="0" 
                                                   Margin="0,0,0,8"
                                                   CornerRadius="8"
                                                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                                   HasShadow="False">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding Title}" 
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                                    <Label Text="{Binding Content}" 
                                                           FontSize="13"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                            
                            <!-- Empty State -->
                            <VerticalStackLayout Padding="24" 
                                                 IsVisible="{Binding HasNotes, Converter={StaticResource InvertedBoolConverter}}"
                                                 HorizontalOptions="Center">
                                <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ExtensionOff}" FontSize="32" HorizontalOptions="Center" Opacity="0.5"/>
                                <Label Text="No notes" 
                                       FontSize="14" 
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Attachments Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>

                            <!-- Card Header — title + carousel navigation controls -->
                            <Grid Padding="16,12"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                  ColumnDefinitions="Auto, *, Auto, Auto, Auto">

                                <Label Grid.Column="0"
                                       mi:MauiIcon.Value="{mi:MaterialOutlined Icon=AttachFile}"
                                       FontSize="20"
                                       TextColor="{StaticResource Warning}"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>

                                <Label Grid.Column="1"
                                       Text="Attachments"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center"/>

                                <!-- "1 of N" counter -->
                                <Label Grid.Column="2"
                                       Text="{Binding AttachmentCountText}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center"
                                       Margin="0,0,4,0"
                                       IsVisible="{Binding HasAttachments}"/>

                                <!-- Previous -->
                                <Button Grid.Column="3"
                                        mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ChevronLeft}"
                                        Command="{Binding PreviousAttachmentCommand}"
                                        IsEnabled="{Binding CanGoPreviousAttachment}"
                                        IsVisible="{Binding HasAttachments}"
                                        BackgroundColor="Transparent"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0"/>

                                <!-- Next -->
                                <Button Grid.Column="4"
                                        mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ChevronRight}"
                                        Command="{Binding NextAttachmentCommand}"
                                        IsEnabled="{Binding CanGoNextAttachment}"
                                        IsVisible="{Binding HasAttachments}"
                                        BackgroundColor="Transparent"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0"/>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>

                            <!-- ═══ Carousel Content (attachments present) ═══ -->
                            <VerticalStackLayout IsVisible="{Binding HasAttachments}"
                                                 Padding="12,12,12,8"
                                                 Spacing="10">

                                <!-- Main preview area — tap to open full viewer -->
                                <Frame CornerRadius="12"
                                       HasShadow="False"
                                       Padding="0"
                                       IsClippedToBounds="True"
                                       HeightRequest="200"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenAttachmentCommand}"
                                            CommandParameter="{Binding CurrentAttachment}"/>
                                    </Frame.GestureRecognizers>

                                    <Grid>
                                        <!-- Image preview (shown once bytes are loaded) -->
                                        <Image Source="{Binding CurrentAttachmentPreviewSource}"
                                               IsVisible="{Binding HasPreviewImage}"
                                               Aspect="AspectFill"/>

                                        <!-- Loading spinner while fetching image bytes -->
                                        <ActivityIndicator IsRunning="{Binding IsLoadingPreview}"
                                                           IsVisible="{Binding IsLoadingPreview}"
                                                           Color="{StaticResource Primary}"
                                                           WidthRequest="48"
                                                           HeightRequest="48"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Center"/>

                                        <!-- File-icon fallback for non-images or failed previews -->
                                        <VerticalStackLayout IsVisible="{Binding ShowFileIcon}"
                                                             VerticalOptions="Center"
                                                             HorizontalOptions="Center"
                                                             Spacing="6">
                                            <Label Text="{Binding CurrentAttachmentFileIcon}"
                                                   FontSize="56"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="{Binding CurrentAttachment.OriginFileName}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   MaximumWidthRequest="200"/>
                                        </VerticalStackLayout>

                                        <!-- "Tap to view" hint at the bottom of the preview -->
                                        <Label Text="Tap to view"
                                               BackgroundColor="#80000000"
                                               TextColor="White"
                                               FontSize="11"
                                               Padding="0,6"
                                               HorizontalOptions="Fill"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="End"/>

                                        <!-- File name + MIME type metadata -->
                                        <Label FontSize="10"
                                            TextColor="White" HorizontalTextAlignment="Start"
                                            VerticalOptions="End" Padding="4,8">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding CurrentAttachmentFileSizeFormatted}"/>
                                                    <Span Text=" • "/>
                                                    <Span Text="{Binding CurrentAttachment.ContentType}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                </Frame>

                                <!-- Right: attachment type badge -->
                                <Frame Padding="8,4"
                                       CornerRadius="12"
                                       HasShadow="False"
                                       VerticalOptions="Center"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                                    <Label FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="🏷️   " />
                                                <Span Text="{Binding CurrentAttachment.AttachmentType.Name}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- ═══ Empty State (no attachments) ═══ -->
                            <VerticalStackLayout Padding="24"
                                                 IsVisible="{Binding HasAttachments, Converter={StaticResource InvertedBoolConverter}}"
                                                 HorizontalOptions="Center">
                                <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ExtensionOff}"
                                       FontSize="32"
                                       HorizontalOptions="Center"
                                       Opacity="0.5"/>
                                <Label Text="No attachments"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
