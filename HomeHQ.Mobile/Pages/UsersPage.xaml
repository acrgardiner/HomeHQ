<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HomeHQ.Mobile.ViewModels"
             xmlns:models="clr-namespace:HomeHQ.Mobile.Models"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="HomeHQ.Mobile.Pages.UsersPage"
             x:DataType="vm:UsersViewModel"
             Title="Users">

    <Grid RowDefinitions="Auto, *">

        <SearchBar Grid.Row="0"
                   Placeholder="Search users..."
                   Text="{Binding SearchText}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                   Margin="16,8"/>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HeightRequest="48"
                           WidthRequest="48"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding ShowEmptyState}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="32">
            <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Person, IconColor={StaticResource Primary}, IconSize=22}"
                   FontSize="64"
                   HorizontalOptions="Center"/>
            <Label Text="No users found"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label Text="Add your first user to get started"
                   FontSize="14"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center"/>
            <Button Text="Add User"
                    Command="{Binding AddCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="44"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding HasError}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="32">
            <Label mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Warning}" FontSize="64" HorizontalOptions="Center"/>
            <Label Text="Something went wrong" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="{Binding ErrorMessage}" FontSize="14" TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            <Button Text="Try Again" Command="{Binding RefreshCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8"/>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     IsVisible="{Binding ShowList}">
            <CollectionView ItemsSource="{Binding Users}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UserListItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Reset PW"
                                               BackgroundColor="#F9A825"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=ResetPasswordCommand}"
                                               CommandParameter="{Binding .}"/>
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="#C62828"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=DeleteCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Frame Margin="16,8" Padding="16" CornerRadius="12" HasShadow="True"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=EditCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="{StaticResource Primary}"
                                            StrokeThickness="0"
                                            StrokeShape="Ellipse"
                                            WidthRequest="44"
                                            HeightRequest="44">
                                        <Label Text="{Binding Initial}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding UserName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding LastLoginDisplay, StringFormat='Last login: {0}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"/>
                                        <Label Text="{Binding RolesDisplay}"
                                               FontSize="12"
                                               TextColor="{StaticResource Primary}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="20"
                                           TextColor="{StaticResource Gray400}" VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1"
                Text="+"
                Command="{Binding AddCommand}"
                IsVisible="{Binding ShowList}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontSize="28"
                CornerRadius="28"
                WidthRequest="56"
                HeightRequest="56"
                Margin="16"
                HorizontalOptions="End"
                VerticalOptions="End"/>
    </Grid>
</ContentPage>
