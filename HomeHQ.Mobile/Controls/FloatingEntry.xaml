<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HomeHQ.Mobile.Controls.FloatingEntry"
             x:Name="Root">

    <Grid>
        <!-- Background border / input container (base layer) -->
        <Border x:Name="InputBorder" Style="{StaticResource InputContainerStyle}" StrokeShape="RoundRectangle 8">
            <Grid>

                <!-- Caller-provided content: place your Entry/Picker/DatePicker or custom view inside the control -->
                <ContentView x:Name="PART_Content"
                             Content="{Binding InnerContent, Source={x:Reference Root}}" />

            </Grid>
        </Border>

        <!-- Floating label overlay -->
        <Label x:Name="FloatingLabel"
               Text="{Binding Title, Source={x:Reference Root}}"
               FontSize="12"
               Padding="4,0"
               Margin="12,-8,0,0"
               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               TextColor="{StaticResource Gray500}">
            <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding IsFocused, Source={x:Reference Root}}"
                             Value="True">
                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

    </Grid>

</ContentView>
