<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="HomeHQ.Mobile.Controls.FloatingEntry"
             x:Name="Root">

    <Grid>
        <!-- Background border / input container (base layer) -->
        <Border x:Name="InputBorder" Style="{StaticResource InputContainerStyle}" StrokeShape="RoundRectangle 8">
            <Grid RowDefinitions="Auto, *" ColumnDefinitions="Auto, *" Padding="6,6">
                <!-- Entry -->
                <Entry x:Name="PART_Entry" Grid.Row="1" Grid.Column="1"
                       Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                       Style="{StaticResource FormEntryStyle}"
                       BackgroundColor="Transparent"
                       Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                       PlaceholderColor="{StaticResource Gray400}"/>
            </Grid>
        </Border>

        <!-- Floating label overlay -->
        <Label x:Name="FloatingLabel"
               Text="{Binding Title, Source={x:Reference Root}}"
               FontSize="12"
               Padding="4,0"
               Margin="12,-8,0,0"
               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               TextColor="{StaticResource Gray500}">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference PART_Entry}, Path=IsFocused}" Value="True">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

    </Grid>

</ContentView>
